@using ASI.Basecode.Services.ViewModelClasses
@model NotificationsIndexViewModel
@{
    ViewData["Title"] = "Notifications";
    var search = ViewBag.Search as string;
    var status = (ViewBag.Status as string) ?? "all";
    var type = (ViewBag.Type as string) ?? "all";
}

<div class="cp-page-header">
    <div>
        <h1 class="cp-page-title">Notifications</h1>
        <p class="cp-page-subtitle">Updates on your reservations, borrowings, due dates and account.</p>
    </div>
    <div class="cp-page-actions">
        <form asp-action="MarkAllRead" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="cp-btn cp-btn-secondary">Mark all as read</button>
        </form>
    </div>
</div>

<div class="cp-filter-bar">
    <form method="get" action="/Notifications" style="display:contents">
        <input type="text" name="search" value="@search" class="cp-input" placeholder="Search notifications..." />
        <select name="status" class="cp-select">
            <option value="all" selected="@(status == "all")">All statuses</option>
            <option value="unread" selected="@(status == "unread")">Unread</option>
            <option value="read" selected="@(status == "read")">Read</option>
        </select>
        <select name="type" class="cp-select">
            <option value="all" selected="@(type == "all")">All types</option>
            <option value="RESERVATION" selected="@(type == "RESERVATION")">Reservations</option>
            <option value="BORROWING" selected="@(type == "BORROWING")">Borrowings</option>
            <option value="ACCOUNT" selected="@(type == "ACCOUNT")">Account</option>
        </select>
        <button type="submit" class="cp-btn cp-btn-secondary cp-btn-sm">Apply</button>
        <a href="/Notifications" class="cp-btn cp-btn-secondary cp-btn-sm">Clear</a>
    </form>
</div>

<div class="cp-card">
    @if (!Model.Notifications.Any())
    {
        <div class="cp-empty-state compact"><div class="cp-empty-state-text">No notifications match your search or filters.</div></div>
    }

    @foreach (var n in Model.Notifications)
    {
        <div class="cp-notif @(n.IsRead ? "" : "unread")">
            @if (!n.IsRead)
            {
                <span class="cp-dot-unread" aria-label="Unread"></span>
            }
            <div class="cp-list-main" style="flex:1">
                <div class="cp-notif-title">@n.Title</div>
                <div class="cp-notif-msg">@n.Message</div>
                <div class="cp-notif-time">@n.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy - hh:mm tt")</div>
            </div>
            @if (!n.IsRead)
            {
                <form asp-action="MarkRead" asp-route-id="@n.NotificationId" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="cp-btn cp-btn-secondary cp-btn-sm">Mark read</button>
                </form>
            }
        </div>
    }
</div>
