@using ASI.Basecode.Services.ViewModelClasses
@model Microsoft.AspNetCore.Mvc.Rendering.SelectList
@{
    ViewData["Title"] = "Switch Operator";
}

<div class="cp-page-header">
    <div>
        <h1 class="cp-page-title">Switch Operator</h1>
        <p class="cp-page-subtitle">Pick the user this session acts as. Audit entries and borrower reservations are recorded against this account.</p>
    </div>
</div>

<div class="cp-card cp-card-narrow">
    <form asp-controller="Operator" asp-action="Select" method="post">
        @Html.AntiForgeryToken()
        @if (!string.IsNullOrEmpty(ViewBag.ReturnUrl as string))
        {
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
        }
        <div class="cp-form-group">
            <label class="cp-form-label" for="userId">Acting user</label>
            <select id="userId" name="userId" class="cp-select" asp-items="ViewBag.UserOptions"></select>
            <div class="cp-form-hint">
                Current operator: @(!string.IsNullOrEmpty(ViewBag.CurrentName as string) ? ViewBag.CurrentName : "none selected")
            </div>
        </div>
        <div class="cp-profile-actions">
            <a asp-controller="Operator" asp-action="Index" class="cp-btn cp-btn-outline">Refresh</a>
            <button type="submit" class="cp-btn cp-btn-success">Switch Operator</button>
        </div>
    </form>
</div>
