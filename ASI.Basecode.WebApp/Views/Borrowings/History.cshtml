@model BorrowingHistoryViewModel
@{
    ViewData["Title"] = "Borrowing History";
    Func<string, string> code = name => (name ?? "").Trim().ToUpperInvariant().Replace(' ', '_');
    var pageNumber = int.TryParse(Context.Request.Query["page"], out var pn) && pn > 0 ? pn : 1;
    const int pageSize = 10;
    var totalCount = Model.Borrowings.Count;
    var pageItems = Model.Borrowings.Skip((pageNumber - 1) * pageSize).Take(pageSize).ToList();
}

<div class="cp-page-header">
    <div>
        <h1 class="cp-page-title">Borrowing History</h1>
        <p class="cp-page-subtitle">Completed and closed borrowing transactions on your record.</p>
    </div>
</div>

<div class="cp-filter-bar">
    <form method="get" action="/Borrowings/History" style="display:contents">
        <input type="text" name="search" value="@Model.Search" class="cp-input" placeholder="Search by equipment, transaction ID or asset code..." />
        <select name="condition" class="cp-select">
            @foreach (var c in Model.ConditionOptions)
            {
                if (Model.Condition == c)
                {
                    <option value="@c" selected>Condition: @c</option>
                }
                else
                {
                    <option value="@c">Condition: @c</option>
                }
            }
        </select>
        <button type="submit" class="cp-btn cp-btn-secondary cp-btn-sm">Apply</button>
        <a href="/Borrowings/History" class="cp-btn cp-btn-secondary cp-btn-sm">Clear</a>
    </form>
</div>

<div class="cp-table-wrap">
    <table class="cp-table">
        <thead>
            <tr>
                <th>Equipment</th>
                <th>Transaction</th>
                <th>Borrowed</th>
                <th>Returned</th>
                <th>Final Condition</th>
                <th>Inspection Notes</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Borrowings.Any())
            {
                <tr><td colspan="8"><div class="cp-empty-state compact"><div class="cp-empty-state-text">No borrowing history yet.</div></div></td></tr>
            }
            @foreach (var b in pageItems)
            {
                <tr>
                    <td>
                        <div class="cp-cell-name">@b.EquipmentName</div>
                        <div class="cp-cell-sub">@b.AssetCode</div>
                    </td>
                    <td class="cp-mono">@b.TransactionNumber</td>
                    <td>@b.ReleasedAtUtc.ToLocalTime().ToString("dd MMM yyyy")<div class="cp-cell-sub">@b.ReleasedAtUtc.ToLocalTime().ToString("hh:mm tt")</div></td>
                    <td>
                        @if (b.ReturnedAtUtc.HasValue)
                        {
                            @b.ReturnedAtUtc.Value.ToLocalTime().ToString("dd MMM yyyy")<div class="cp-cell-sub">@b.ReturnedAtUtc.Value.ToLocalTime().ToString("hh:mm tt")</div>
                        }
                        else
                        {
                            <span class="cp-cell-sub">-</span>
                        }
                    </td>
                    <td>
                        @if (string.IsNullOrWhiteSpace(b.FinalConditionName))
                        {
                            <span class="cp-cell-sub">-</span>
                        }
                        else
                        {
                            <span class="@StatusBadge.Css(code(b.FinalConditionName))">@b.FinalConditionName</span>
                        }
                    </td>
                    <td>@(string.IsNullOrWhiteSpace(b.InspectionNotes) ? "-" : b.InspectionNotes)</td>
                    <td><span class="@StatusBadge.Css(code(b.StatusDescription))">@b.StatusDescription</span></td>
                    <td><a class="cp-btn cp-btn-secondary cp-btn-sm" href="/Borrowings/Details/@b.BorrowingId">View</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pagination", new ASI.Basecode.WebApp.Models.PaginationModel
{
    Page = pageNumber,
    TotalPages = (int)Math.Ceiling(totalCount / (double)pageSize),
    TotalCount = totalCount,
    Info = $"Page {pageNumber} of {(int)Math.Ceiling(totalCount / (double)pageSize)} ({totalCount} records)",
})
