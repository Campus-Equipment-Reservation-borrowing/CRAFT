@model BorrowingDetailsViewModel
@{
    ViewData["Title"] = $"Borrowing {Model.TransactionNumber}";
    var remaining = (Model.DueAtUtc.ToLocalTime().Date - DateTime.Now.Date).Days;
    Func<string, string> code = name => (name ?? "").Trim().ToUpperInvariant().Replace(' ', '_');
}

<div class="cp-page-header">
    <div>
        <partial name="_Breadcrumb" model='new[] { ("My Borrowings", "/Borrowings/Mine") }' />
        <h1 class="cp-page-title">Borrowing @Model.TransactionNumber</h1>
        <p class="cp-page-subtitle">Release and return record for this borrowing.</p>
    </div>
</div>

<div class="cp-grid-2">
    <div class="cp-card">
        <div class="cp-card-header">
            Summary
            <span class="@StatusBadge.Css(Model.IsOverdue && !Model.IsReturned ? "OVERDUE" : Model.StatusCode)">@Model.StatusDescription</span>
        </div>
        <dl class="cp-kv">
            <dt>Equipment</dt><dd>@Model.EquipmentName</dd>
            <dt>Asset Code</dt><dd class="cp-mono">@Model.AssetCode</dd>
            <dt>Category</dt><dd>@Model.CategoryName</dd>
            <dt>Location</dt><dd>@(Model.LocationName ?? "-")</dd>
            <dt>Quantity Released</dt><dd>@Model.Quantity unit@(Model.Quantity == 1 ? "" : "s")</dd>
            <dt>Released</dt>
            <dd>
                @Model.ReleasedAtUtc.ToLocalTime().ToString("dd MMMM yyyy, hh:mm tt")
                @if (!string.IsNullOrWhiteSpace(Model.ReleasedBy))
                {
                    <div class="cp-cell-sub">by @Model.ReleasedBy</div>
                }
            </dd>
            <dt>Condition at Release</dt>
            <dd>
                @if (string.IsNullOrWhiteSpace(Model.ReleaseConditionName))
                {
                    <text>-</text>
                }
                else
                {
                    <span class="@StatusBadge.Css(code(Model.ReleaseConditionName))">@Model.ReleaseConditionName</span>
                }
            </dd>
            <dt>Due</dt>
            <dd>
                @Model.DueAtUtc.ToLocalTime().ToString("dd MMMM yyyy, hh:mm tt")
                @if (!Model.IsReturned)
                {
                    <div class="cp-cell-sub">
                        @if (remaining < 0) { <text>@(-remaining) day@(remaining == -1 ? "" : "s") overdue</text> }
                        else if (remaining == 0) { <text>Due today</text> }
                        else { <text>@remaining day@(remaining == 1 ? "" : "s") left</text> }
                    </div>
                }
            </dd>
        </dl>
    </div>

    <div class="cp-card">
        <div class="cp-card-header">Return Information</div>
        @if (Model.IsReturned)
        {
            <dl class="cp-kv">
                <dt>Returned On</dt><dd>@(Model.ReturnedAtUtc?.ToLocalTime().ToString("dd MMMM yyyy, hh:mm tt") ?? "-")</dd>
                <dt>Returned Quantity</dt><dd>@(Model.ReturnedQuantity?.ToString() ?? Model.Quantity.ToString()) unit@(Model.Quantity == 1 ? "" : "s")</dd>
                <dt>Received By</dt><dd>@(Model.ReceivedBy ?? "-")</dd>
                <dt>Final Condition</dt>
                <dd>
                    @if (string.IsNullOrWhiteSpace(Model.FinalConditionName))
                    {
                        <text>-</text>
                    }
                    else
                    {
                        <span class="@StatusBadge.Css(code(Model.FinalConditionName))">@Model.FinalConditionName</span>
                    }
                </dd>
                @if (!string.IsNullOrWhiteSpace(Model.InspectionNotes))
                {
                    <dt>Inspection Notes</dt><dd>@Model.InspectionNotes</dd>
                }
            </dl>
        }
        else
        {
            <div class="cp-empty-state compact">
                <div class="cp-empty-state-text">Not yet returned. Return details and the condition inspection appear here once the custodian records the return.</div>
            </div>
        }
    </div>
</div>
