@model BorrowingMineViewModel
@{
    ViewData["Title"] = "My Borrowings";
    var overdue = Model.Borrowings.Where(b => b.IsOverdue).ToList();
    var pageNumber = int.TryParse(Context.Request.Query["page"], out var pn) && pn > 0 ? pn : 1;
    const int pageSize = 10;
    var totalCount = Model.Borrowings.Count;
    var pageItems = Model.Borrowings.Skip((pageNumber - 1) * pageSize).Take(pageSize).ToList();
}

<div class="cp-page-header">
    <div>
        <h1 class="cp-page-title">My Borrowings</h1>
        <p class="cp-page-subtitle">Equipment currently released to you. Return items on or before the due date.</p>
    </div>
</div>

@if (overdue.Any())
{
    <div class="banner err">
        <div class="banner-b">
            <div class="banner-t">Return your overdue item@(overdue.Count == 1 ? "" : "s")</div>
            <div>@overdue.First().EquipmentName@(overdue.Count > 1 ? $" and {overdue.Count - 1} more" : "") is @overdue.First().DaysOverdue day@(overdue.First().DaysOverdue == 1 ? "" : "s") overdue. New reservation requests are blocked until it is returned.</div>
        </div>
    </div>
}

<div class="cp-filter-bar">
    <form method="get" action="/Borrowings/Mine" style="display:contents">
        <input type="text" name="search" value="@Model.Search" class="cp-input" placeholder="Search by equipment or transaction ID..." />
        <button type="submit" class="cp-btn cp-btn-secondary cp-btn-sm">Apply</button>
        <a href="/Borrowings/Mine" class="cp-btn cp-btn-secondary cp-btn-sm">Clear</a>
    </form>
</div>

<div class="cp-table-wrap">
    <table class="cp-table">
        <thead>
            <tr>
                <th>Equipment</th>
                <th>Transaction</th>
                <th>Qty</th>
                <th>Released</th>
                <th>Condition at Release</th>
                <th>Due</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Borrowings.Any())
            {
                <tr><td colspan="8"><div class="cp-empty-state compact"><div class="cp-empty-state-text">You have no active borrowings.</div></div></td></tr>
            }
            @foreach (var b in pageItems)
            {
                var daysLeft = (b.DueAtUtc.ToLocalTime().Date - DateTime.Now.Date).Days;
                var dueToday = b.IsDueToday && !b.IsOverdue;
                <tr>
                    <td>
                        <div class="cp-cell-name">@b.EquipmentName</div>
                        <div class="cp-cell-sub">@b.AssetCode</div>
                    </td>
                    <td class="cp-mono">@b.TransactionNumber</td>
                    <td>@b.Quantity</td>
                    <td>@b.ReleasedAtUtc.ToLocalTime().ToString("dd MMM yyyy")<div class="cp-cell-sub">@b.ReleasedAtUtc.ToLocalTime().ToString("hh:mm tt")</div></td>
                    <td>
                        @if (string.IsNullOrWhiteSpace(b.ReleaseConditionName))
                        {
                            <span class="cp-cell-sub">-</span>
                        }
                        else
                        {
                            <span class="@StatusBadge.Css(b.ReleaseConditionName.ToUpperInvariant().Replace(' ', '_'))">@b.ReleaseConditionName</span>
                        }
                    </td>
                    <td>
                        @b.DueAtUtc.ToLocalTime().ToString("dd MMM yyyy")
                        <div class="cp-cell-sub">
                            @if (daysLeft < 0) { <text>@(-daysLeft) day@(daysLeft == -1 ? "" : "s") overdue</text> }
                            else if (daysLeft == 0) { <text>@b.DueAtUtc.ToLocalTime().ToString("hh:mm tt")</text> }
                            else { <text>@daysLeft day@(daysLeft == 1 ? "" : "s") left</text> }
                        </div>
                    </td>
                    <td><span class="@StatusBadge.Css(dueToday ? "DUE_TODAY" : b.StatusCode)">@(dueToday ? "Due Today" : b.StatusDescription)</span></td>
                    <td><a class="cp-btn cp-btn-secondary cp-btn-sm" href="/Borrowings/Details/@b.BorrowingId">View Details</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pagination", new ASI.Basecode.WebApp.Models.PaginationModel
{
    Page = pageNumber,
    TotalPages = (int)Math.Ceiling(totalCount / (double)pageSize),
    TotalCount = totalCount,
    Info = $"Page {pageNumber} of {(int)Math.Ceiling(totalCount / (double)pageSize)} ({totalCount} records)",
})
