@using ASI.Basecode.Services.ViewModelClasses
@model ReservationDetailsViewModel
@{
    ViewData["Title"] = "Reservation Details";
}

<div class="cp-page-header">
    <div>
        <partial name="_Breadcrumb" model='new[] { ("My Reservations", "/Reservations/Mine") }' />
        <h1 class="cp-page-title">Reservation Details</h1>
        <p class="cp-page-subtitle">Reservation <span class="cp-mono">@Model.ReservationNumber</span> and its current status.</p>
    </div>
    <div class="cp-page-actions">
        @if (Model.StatusCode is "APPROVED" or "READY_FOR_RELEASE" or "PARTIALLY_RELEASED")
        {
            <a asp-controller="Reservations" asp-action="Slip" asp-route-id="@Model.ReservationId" class="cp-btn cp-btn-secondary cp-btn-sm">Print pickup slip</a>
        }
        @if (Model.CanCancel)
        {
            <form method="post" asp-controller="Reservations" asp-action="Cancel" asp-route-id="@Model.ReservationId" style="display:inline;"
                  onsubmit="return confirm('Cancel this reservation request?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="cp-btn cp-btn-danger cp-btn-sm">Cancel Reservation</button>
            </form>
        }
    </div>
</div>

<div class="cp-grid-2">
    <div class="cp-stack">
        <div class="cp-card">
            <div class="cp-card-header">
                Request Status
                <span class="@StatusBadge.Css(Model.StatusCode)">@Model.StatusDescription</span>
            </div>
            <dl class="cp-kv">
                <dt>Submitted</dt><dd>@Model.SubmittedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>
                @if (Model.CompletedAtUtc.HasValue)
                {
                    <dt>Completed</dt><dd>@Model.CompletedAtUtc.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>
                }
                @if (!string.IsNullOrEmpty(Model.BorrowerName))
                {
                    <dt>Borrower</dt><dd>@Model.BorrowerName</dd>
                }
                @if (!string.IsNullOrEmpty(Model.PolicyVersionNumber))
                {
                    <dt>Policy version</dt><dd>@Model.PolicyVersionNumber</dd>
                }
            </dl>
        </div>

        <div class="cp-card">
            <div class="cp-card-header">Equipment &amp; Schedule</div>
            <dl class="cp-kv">
                <dt>Equipment</dt><dd>@Model.EquipmentName <span class="cp-cell-sub">(@Model.AssetCode)</span></dd>
                <dt>Category</dt><dd>@Model.CategoryName</dd>
                <dt>Pickup Point</dt><dd>@(Model.PickupLocationName ?? "—")</dd>
                <dt>Borrowing Start</dt><dd>@Model.RequestedStartAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>
                <dt>Expected Return</dt><dd>@Model.ExpectedReturnAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>
            </dl>
        </div>
    </div>

    <div class="cp-stack">
        <div class="cp-card">
            <div class="cp-card-header">Quantities</div>
            <dl class="cp-kv">
                <dt>Requested</dt><dd>@Model.RequestedQuantity</dd>
                <dt>Approved</dt><dd>@(Model.ApprovedQuantity > 0 ? Model.ApprovedQuantity.ToString() : "—")</dd>
                <dt>Held for pickup</dt><dd>@(Model.HeldQuantity > 0 ? Model.HeldQuantity.ToString() : "—")</dd>
            </dl>
        </div>

        <div class="cp-card">
            <div class="cp-card-header">Purpose &amp; Notes</div>
            <dl class="cp-kv">
                <dt>Purpose</dt><dd>@Model.Purpose</dd>
                @if (!string.IsNullOrWhiteSpace(Model.AdditionalNotes))
                {
                    <dt>Additional notes</dt><dd>@Model.AdditionalNotes</dd>
                }
                <dt>Acknowledgements</dt><dd>Borrowing rules and overdue/accountability terms acknowledged at submission.</dd>
            </dl>
        </div>
    </div>
</div>
