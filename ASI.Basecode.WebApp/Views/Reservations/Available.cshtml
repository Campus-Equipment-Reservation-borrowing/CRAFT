@using ASI.Basecode.Services.ViewModelClasses
@using Microsoft.AspNetCore.Mvc.Rendering
@model EquipmentAvailabilityIndexViewModel
@{
    ViewData["Title"] = "Equipment Availability";
    var items = Model.Page?.Items ?? new List<EquipmentAvailabilityRowViewModel>();
    Func<string, string> code = name => (name ?? "").Trim().ToUpperInvariant().Replace(' ', '_');
}

<div class="cp-page-header">
    <div>
        <h1 class="cp-page-title">Equipment Availability</h1>
        <p class="cp-page-subtitle">Browse the equipment catalog and check live stock before reserving.</p>
    </div>
</div>

<div class="cp-filter-bar">
    <form method="get" asp-action="Available" class="cp-contents">
        <input type="text" name="search" value="@Model.Search" class="cp-input" placeholder="Search by equipment name or asset code..." />
        <select name="category" class="cp-select">
            <option value="">All categories</option>
            @if (ViewBag.CategoryOptions != null)
            {
                foreach (Microsoft.AspNetCore.Mvc.Rendering.SelectListItem c in (SelectList)ViewBag.CategoryOptions)
                {
                    if (Model.CategoryId?.ToString() == c.Value)
                    {
                        <option value="@c.Value" selected>@c.Text</option>
                    }
                    else
                    {
                        <option value="@c.Value">@c.Text</option>
                    }
                }
            }
        </select>
        <button type="submit" class="cp-btn cp-btn-secondary cp-btn-sm">Apply</button>
        <a asp-action="Available" class="cp-btn cp-btn-secondary cp-btn-sm">Clear</a>
    </form>
</div>

@if (!items.Any())
{
    <div class="cp-card">
        <div class="cp-empty-state compact">
            <div class="cp-empty-state-text">No equipment matches your search or filter. Try a different keyword or clear the filters.</div>
        </div>
    </div>
}
else
{
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:15px">
        @foreach (var eq in items)
        {
            var pct = eq.TotalQuantity > 0 ? (int)Math.Round(eq.AvailableUnits * 100.0 / eq.TotalQuantity) : 0;
            var isOut = eq.AvailableUnits <= 0;
            <a href="/Reservations/EquipmentDetails/@eq.EquipmentId" class="eq-card @(isOut ? "off" : "")">
                @if (!string.IsNullOrWhiteSpace(eq.ImagePath))
                {
                    <div class="eq-img">
                        <img src="@eq.ImagePath" alt="@eq.EquipmentName" class="cp-img-fill" />
                    </div>
                }
                <div class="eq-b">
                    <div class="cp-row-between">
                        <div class="eq-t">@eq.EquipmentName</div>
                        @if (!string.IsNullOrWhiteSpace(eq.ConditionName))
                        {
                            <span class="@StatusBadge.Css(code(eq.ConditionName))">@eq.ConditionName</span>
                        }
                    </div>
                    <div class="eq-m">@eq.CategoryName &middot; @(eq.LocationName ?? "No location")</div>
                    <div class="eq-m">@(isOut ? "Out of stock" : $"{eq.AvailableUnits} of {eq.TotalQuantity} available")</div>
                    <div class="cp-progress"><span style="width:@(pct)%"></span></div>
                </div>
            </a>
        }
    </div>

    @if (Model.Page != null && Model.Page.TotalPages > 1)
    {
        <div class="cp-pagination">
            <span class="cp-pagination-info">Page @Model.Page.Page of @Model.Page.TotalPages (@Model.Page.TotalCount items)</span>
            <ul class="cp-pagination-list">
                <li class="@(Model.Page.HasPrevious ? "" : "disabled")">
                    <a asp-action="Available" asp-route-search="@Model.Search" asp-route-category="@Model.CategoryId" asp-route-page="@(Model.Page.Page - 1)">‹</a>
                </li>
                @for (var p = 1; p <= Model.Page.TotalPages; p++)
                {
                    <li class="@(p == Model.Page.Page ? "active" : "")">
                        <a asp-action="Available" asp-route-search="@Model.Search" asp-route-category="@Model.CategoryId" asp-route-page="@p">@p</a>
                    </li>
                }
                <li class="@(Model.Page.HasNext ? "" : "disabled")">
                    <a asp-action="Available" asp-route-search="@Model.Search" asp-route-category="@Model.CategoryId" asp-route-page="@(Model.Page.Page + 1)">›</a>
                </li>
            </ul>
        </div>
    }
}
