@model EquipmentDetailsViewModel
@{
    ViewData["Title"] = Model.EquipmentName;
    var isOut = Model.AvailableUnits <= 0;
    var statusCode = Model.IsUnderMaintenance ? "UNDER_MAINTENANCE" : (isOut ? "OUT_OF_STOCK" : "AVAILABLE");
    var statusLabel = Model.IsUnderMaintenance ? "Under Maintenance" : (isOut ? "Out of Stock" : "Available");
    var pct = Model.TotalQuantity > 0 ? (int)Math.Round(Model.AvailableUnits * 100.0 / Model.TotalQuantity) : 0;
}

<div class="cp-page-header">
    <div>
        <partial name="_Breadcrumb" model='new[] { ("Equipment", "/Reservations/Available") }' />
        <h1 class="cp-page-title">@Model.EquipmentName</h1>
        <p class="cp-page-subtitle">Check availability and borrowing rules before reserving.</p>
    </div>
</div>

<div class="cp-grid-2">
    <div class="cp-stack">
        <div class="cp-card">
            @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
            {
                <div class="eq-img">
                    <img src="@Model.ImagePath" alt="@Model.EquipmentName" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
                </div>
            }
            <div class="cp-card-header">Details</div>
            <p class="cp-cell-sub">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided for this equipment." : Model.Description)</p>
            <dl class="cp-kv">
                <dt>Asset Code</dt><dd class="cp-mono">@Model.AssetCode</dd>
                <dt>Category</dt><dd>@Model.CategoryName</dd>
                <dt>Location</dt><dd>@(Model.LocationName ?? "-")</dd>
                <dt>Condition</dt>
                <dd>
                    @if (string.IsNullOrWhiteSpace(Model.ConditionName))
                    {
                        <text>-</text>
                    }
                    else
                    {
                        <span class="@StatusBadge.Css(Model.ConditionName.Trim().ToUpperInvariant().Replace(' ', '_'))">@Model.ConditionName</span>
                    }
                </dd>
            </dl>
        </div>

        <div class="cp-card">
            <div class="cp-card-header">
                Borrowing Rules
                <span class="cp-cell-sub">From System Settings</span>
            </div>
            <dl class="cp-kv">
                <dt>Maximum borrowing duration</dt><dd>@Model.MaxBorrowDays days</dd>
                <dt>Faculty maximum duration</dt><dd>@Model.FacultyMaxBorrowDays days</dd>
                <dt>Maximum units per request</dt><dd>@Model.MaxUnitsPerBorrower unit@(Model.MaxUnitsPerBorrower == 1 ? "" : "s")</dd>
                <dt>Reservation lead time</dt><dd>@Model.ReservationLeadTimeDays day@(Model.ReservationLeadTimeDays == 1 ? "" : "s") in advance</dd>
                <dt>Return policy</dt><dd>Return by the expected return date; overdue items block new requests.</dd>
            </dl>
        </div>
    </div>

    <div class="cp-card">
        <div class="cp-card-header">
            Availability
            <span class="@StatusBadge.Css(statusCode)">@statusLabel</span>
        </div>
        <div class="cp-stack">
            <div>
                <div class="cp-row-between">
                    <span class="cp-cell-name">@Model.AvailableUnits of @Model.TotalQuantity available</span>
                </div>
                <div class="cp-progress"><span style="width:@(pct)%"></span></div>
            </div>
            @if (Model.CanReserve)
            {
                <a href="/Reservations/New/@Model.EquipmentId" class="cp-btn cp-btn-primary cp-btn-lg">Reserve Equipment</a>
            }
            else
            {
                <div class="banner err">
                    <div class="banner-b"><div class="banner-t">Not available to reserve</div><div>@Model.UnavailableReason</div></div>
                </div>
            }
        </div>
    </div>
</div>
