@model ReservationMineViewModel
@{
    ViewData["Title"] = "My Reservations";
    var search = ViewBag.Search as string;
}

<div class="cp-page-header">
    <div>
        <h1 class="cp-page-title">My Reservations</h1>
        <p class="cp-page-subtitle">Every reservation request you have submitted, across all statuses.</p>
    </div>
    <div class="cp-page-actions">
        <a class="cp-btn cp-btn-primary" href="/Reservations/Available">Browse Equipment for Reservation</a>
    </div>
</div>

<div class="cp-filter-bar">
    <form method="get" action="/Reservations/Mine" style="display:contents">
        <input type="text" name="search" value="@search" class="cp-input" placeholder="Search by reservation ID or equipment name..." />
        <button type="submit" class="cp-btn cp-btn-secondary cp-btn-sm">Apply</button>
        <a href="/Reservations/Mine" class="cp-btn cp-btn-secondary cp-btn-sm">Clear</a>
    </form>
</div>

<div class="cp-table-wrap">
    <table class="cp-table">
        <thead>
            <tr>
                <th>Reservation</th>
                <th>Equipment</th>
                <th>Qty</th>
                <th>Requested Schedule</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Reservations.Any())
            {
                <tr><td colspan="6"><div class="cp-empty-state compact"><div class="cp-empty-state-text">You have no reservation requests yet.</div></div></td></tr>
            }
            @foreach (var r in Model.Reservations)
            {
                <tr>
                    <td class="cp-mono">@r.ReservationNumber</td>
                    <td>
                        <div class="cp-cell-name">@r.EquipmentName</div>
                        <div class="cp-cell-sub">@r.AssetCode</div>
                    </td>
                    <td>@r.RequestedQuantity</td>
                    <td>@r.RequestedStartAtUtc.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")<div class="cp-cell-sub">Return @r.ExpectedReturnAtUtc.ToLocalTime().ToString("dd MMM, hh:mm tt")</div></td>
                    <td><span class="@StatusBadge.Css(r.StatusCode)">@r.StatusDescription</span></td>
                    <td>
                        <a class="cp-btn cp-btn-secondary cp-btn-sm" href="/Reservations/Details/@r.ReservationId">View</a>
                        @if (r.CanCancel)
                        {
                            <form method="post" action="/Reservations/Cancel/@r.ReservationId" style="display:inline" onsubmit="return confirm('Cancel this reservation request?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="cp-btn cp-btn-outline cp-btn-sm">Cancel</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
