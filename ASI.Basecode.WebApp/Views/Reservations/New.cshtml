@using ASI.Basecode.Services.ViewModelClasses
@model ReservationFormContextViewModel
@{
    ViewData["Title"] = "Reservation Form";
}

<div class="cp-page-header">
    <div>
        <partial name="_Breadcrumb" model='new[] { ("Equipment", "/Reservations/Available") }' />
        <h1 class="cp-page-title">Reservation Form</h1>
        <p class="cp-page-subtitle">Your request will be queued for custodian review.</p>
    </div>
</div>

<div class="cp-grid-2">
    <div class="cp-card">
        <form asp-controller="Reservations" asp-action="New" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Form.EquipmentId" />
            <div asp-validation-summary="ModelOnly" class="cp-alert cp-alert-error"></div>

            <div class="cp-form-row">
                <div class="cp-form-group">
                    <label asp-for="Form.Quantity" class="cp-form-label">Quantity <span class="required">*</span></label>
                    @{
                        var maxUnits = Model.Equipment?.MaxUnitsPerBorrower > 0 ? Model.Equipment.MaxUnitsPerBorrower : 3;
                        var maxQty = Model.Equipment != null ? Math.Max(1, Math.Min(maxUnits, Model.Equipment.AvailableUnits)) : maxUnits;
                    }
                    <input asp-for="Form.Quantity" type="number" class="cp-input" min="1" max="@maxQty" step="1" required />
                    <div class="cp-form-hint">Maximum @maxUnits units per borrower.</div>
                    <span asp-validation-for="Form.Quantity" class="cp-form-error"></span>
                </div>
                <div class="cp-form-group">
                    <label asp-for="Form.PickupLocationId" class="cp-form-label">Pickup Point <span class="required">*</span></label>
                    <select asp-for="Form.PickupLocationId" class="cp-select" required asp-items="@(ViewBag.PickupOptions as SelectList)"></select>
                    <span asp-validation-for="Form.PickupLocationId" class="cp-form-error"></span>
                </div>
            </div>

            <div class="cp-section-title">Borrowing Schedule</div>
            <div class="cp-form-hint" id="rsv-schedule-hint"
                 data-lead-days="@(Model.Equipment?.ReservationLeadTimeDays ?? 1)"
                 data-max-days="@(Model.Equipment?.MaxAdvanceBookingDays ?? 30)">
                Pickup must be at least @(Model.Equipment?.ReservationLeadTimeDays ?? 1) day(s) from now and at most @(Model.Equipment?.MaxAdvanceBookingDays ?? 30) days ahead.
            </div>
            <div class="cp-form-row">
                <div class="cp-form-group">
                    <label asp-for="Form.BorrowingDate" class="cp-form-label">Borrowing Date <span class="required">*</span></label>
                    <input asp-for="Form.BorrowingDate" type="date" class="cp-input" required />
                    <span asp-validation-for="Form.BorrowingDate" class="cp-form-error"></span>
                </div>
                <div class="cp-form-group">
                    <label asp-for="Form.BorrowingTime" class="cp-form-label">Borrowing Time <span class="required">*</span></label>
                    <input asp-for="Form.BorrowingTime" type="time" class="cp-input" required />
                    <span asp-validation-for="Form.BorrowingTime" class="cp-form-error"></span>
                </div>
            </div>

            <div class="cp-section-title">Expected Return</div>
            <div class="cp-form-row">
                <div class="cp-form-group">
                    <label asp-for="Form.ExpectedReturnDate" class="cp-form-label">Expected Return Date <span class="required">*</span></label>
                    <input asp-for="Form.ExpectedReturnDate" type="date" class="cp-input" required />
                    <span asp-validation-for="Form.ExpectedReturnDate" class="cp-form-error"></span>
                </div>
                <div class="cp-form-group">
                    <label asp-for="Form.ExpectedReturnTime" class="cp-form-label">Expected Return Time <span class="required">*</span></label>
                    <input asp-for="Form.ExpectedReturnTime" type="time" class="cp-input" required />
                    <span asp-validation-for="Form.ExpectedReturnTime" class="cp-form-error"></span>
                </div>
            </div>

            <div class="cp-section-title">Purpose &amp; Notes</div>
            <div class="cp-form-group">
                <label asp-for="Form.Purpose" class="cp-form-label">Purpose of Borrowing <span class="required">*</span></label>
                <textarea asp-for="Form.Purpose" class="cp-textarea" required rows="3" placeholder="Be specific — the custodian uses this to prioritise competing requests."></textarea>
                <span asp-validation-for="Form.Purpose" class="cp-form-error"></span>
            </div>
            <div class="cp-form-group">
                <label asp-for="Form.AdditionalNotes" class="cp-form-label">Additional Notes</label>
                <textarea asp-for="Form.AdditionalNotes" class="cp-textarea" rows="2" placeholder="Optional remarks for the custodian."></textarea>
                <span asp-validation-for="Form.AdditionalNotes" class="cp-form-error"></span>
            </div>

            <div class="cp-section-title">Acknowledgements</div>
            <div class="cp-form-group">
                <label class="cp-check">
                    <input type="checkbox" asp-for="Form.AcknowledgeRules" required />
                    I acknowledge the borrowing rules and accept accountability for damage, loss or late return of this equipment.
                </label>
                <span asp-validation-for="Form.AcknowledgeRules" class="cp-form-error"></span>
            </div>
            <div class="cp-form-group">
                <label class="cp-check">
                    <input type="checkbox" asp-for="Form.AcknowledgeResponsibility" required />
                    I understand that overdue items may suspend my borrowing privileges for the remainder of the term.
                </label>
                <span asp-validation-for="Form.AcknowledgeResponsibility" class="cp-form-error"></span>
            </div>

            <div class="cp-row-between">
                <a asp-controller="Reservations" asp-action="Available" class="cp-btn cp-btn-secondary">Back</a>
                <button type="submit" class="cp-btn cp-btn-success">Submit Reservation</button>
            </div>
        </form>
        <script>
            // Keep the pickers inside the policy window so past / too-early times can't be chosen.
            // The server re-checks everything; this just stops the user picking a time it will reject.
            (function () {
                var hint = document.getElementById('rsv-schedule-hint');
                var bd = document.querySelector('[name="Form.BorrowingDate"]');
                var bt = document.querySelector('[name="Form.BorrowingTime"]');
                var rd = document.querySelector('[name="Form.ExpectedReturnDate"]');
                var rt = document.querySelector('[name="Form.ExpectedReturnTime"]');
                if (!hint || !bd || !bt || !rd || !rt) return;
                var leadDays = parseInt(hint.getAttribute('data-lead-days'), 10) || 0;
                var maxDays = parseInt(hint.getAttribute('data-max-days'), 10) || 30;
                function pad(n) { return (n < 10 ? '0' : '') + n; }
                function ymd(d) { return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()); }
                function hm(d) { return pad(d.getHours()) + ':' + pad(d.getMinutes()); }
                function at(dateStr, timeStr) { return dateStr && timeStr ? new Date(dateStr + 'T' + timeStr) : null; }
                function earliest() {
                    // now + lead time, rounded up to the next 5 minutes
                    var e = new Date(Date.now() + leadDays * 86400000);
                    e.setSeconds(0, 0);
                    e.setMinutes(Math.ceil(e.getMinutes() / 5) * 5);
                    return e;
                }
                function latest() { return new Date(Date.now() + maxDays * 86400000); }
                var fmt = { weekday: 'short', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' };

                function refresh() {
                    var e = earliest(), l = latest();
                    bd.min = ymd(e); bd.max = ymd(l);
                    bt.min = bd.value === ymd(e) ? hm(e) : '';
                    bt.max = bd.value === ymd(l) ? hm(l) : '';
                    rd.min = bd.value || ymd(e);
                    rt.min = (rd.value && rd.value === bd.value && bt.value) ? bt.value : '';
                    hint.textContent = 'Earliest pickup: ' + e.toLocaleString(undefined, fmt) +
                        ' (at least ' + leadDays + ' day' + (leadDays === 1 ? '' : 's') + ' from now), up to ' + maxDays + ' days ahead.';

                    var start = at(bd.value, bt.value), end = at(rd.value, rt.value);
                    bt.setCustomValidity(start && start < e ? 'Pick a pickup time on or after ' + e.toLocaleString(undefined, fmt) + '.' : '');
                    rt.setCustomValidity(start && end && end <= start ? 'The return must be after the pickup time.' : '');
                }
                [bd, bt, rd, rt].forEach(function (el) { el.addEventListener('input', refresh); el.addEventListener('change', refresh); });
                // Re-check right before submitting, in case the page sat open and the clock moved on.
                bd.form.addEventListener('submit', function (ev) {
                    refresh();
                    if (!bd.form.checkValidity()) { ev.preventDefault(); bd.form.reportValidity(); }
                }, true);
                refresh();
            })();
        </script>
    </div>

    <div class="cp-stack">
        <div class="cp-card">
            <div class="cp-card-header">Selected Equipment</div>
            @if (Model.Equipment != null)
            {
                <dl class="cp-kv">
                    <dt>Equipment</dt><dd>@Model.Equipment.EquipmentName</dd>
                    <dt>Asset Code</dt><dd class="cp-mono">@Model.Equipment.AssetCode</dd>
                    <dt>Category</dt><dd>@Model.Equipment.CategoryName</dd>
                    @if (!string.IsNullOrEmpty(Model.Equipment.LocationName))
                    {
                        <dt>Location</dt><dd>@Model.Equipment.LocationName</dd>
                    }
                    <dt>Available</dt><dd>@Model.Equipment.AvailableUnits of @Model.Equipment.TotalQuantity units</dd>
                    @if (!string.IsNullOrWhiteSpace(Model.Equipment.ConditionName))
                    {
                        <dt>Condition</dt><dd><span class="@StatusBadge.Css(Model.Equipment.ConditionName.Trim().ToUpperInvariant().Replace(' ', '_'))">@Model.Equipment.ConditionName</span></dd>
                    }
                </dl>
            }
            else
            {
                <div class="cp-empty-state compact"><div class="cp-empty-state-text">Equipment summary unavailable.</div></div>
            }
        </div>

        <div class="cp-card">
            <div class="cp-card-header">Review Time</div>
            <div class="cp-stack">
                <div class="cp-cell-sub">Requests are normally reviewed within one working day. You will be notified once a decision is made.</div>
                <div class="cp-cell-sub">Cancellation window — you may cancel this request any time while it is still Pending or Approved.</div>
            </div>
        </div>
    </div>
</div>
