@using ASI.Basecode.Services.ViewModelClasses
@model ReservationFormContextViewModel
@{
    ViewData["Title"] = "Reservation Form";
}

<div class="cp-page-header">
    <div>
        <partial name="_Breadcrumb" model='new[] { ("Equipment", "/Reservations/Available") }' />
        <h1 class="cp-page-title">Reservation Form</h1>
        <p class="cp-page-subtitle">Your request will be queued for custodian review.</p>
    </div>
</div>

<div asp-validation-summary="ModelOnly" class="cp-validation-summary"></div>

<div class="cp-grid-2">
    <div class="cp-card">
        <form asp-controller="Reservations" asp-action="New" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Form.EquipmentId" />

            <div class="cp-form-row">
                <div class="cp-form-group">
                    <label asp-for="Form.Quantity" class="cp-form-label">Quantity <span class="required">*</span></label>
                    <input asp-for="Form.Quantity" type="number" class="cp-input" min="1" />
                    <div class="cp-form-hint">Maximum 3 units per borrower.</div>
                    <span asp-validation-for="Form.Quantity" class="cp-form-error"></span>
                </div>
                <div class="cp-form-group">
                    <label class="cp-form-label">Pickup Point <span class="required">*</span></label>
                    <select asp-for="Form.PickupLocationId" class="cp-select" asp-items="@(ViewBag.PickupOptions as SelectList)"></select>
                    <span asp-validation-for="Form.PickupLocationId" class="cp-form-error"></span>
                </div>
            </div>

            <div class="cp-section-title">Borrowing Schedule</div>
            <div class="cp-form-row">
                <div class="cp-form-group">
                    <label asp-for="Form.BorrowingDate" class="cp-form-label">Borrowing Date <span class="required">*</span></label>
                    <input asp-for="Form.BorrowingDate" type="date" class="cp-input" />
                    <span asp-validation-for="Form.BorrowingDate" class="cp-form-error"></span>
                </div>
                <div class="cp-form-group">
                    <label asp-for="Form.BorrowingTime" class="cp-form-label">Borrowing Time <span class="required">*</span></label>
                    <input asp-for="Form.BorrowingTime" type="time" class="cp-input" />
                    <span asp-validation-for="Form.BorrowingTime" class="cp-form-error"></span>
                </div>
            </div>

            <div class="cp-section-title">Expected Return</div>
            <div class="cp-form-row">
                <div class="cp-form-group">
                    <label asp-for="Form.ExpectedReturnDate" class="cp-form-label">Expected Return Date <span class="required">*</span></label>
                    <input asp-for="Form.ExpectedReturnDate" type="date" class="cp-input" />
                    <span asp-validation-for="Form.ExpectedReturnDate" class="cp-form-error"></span>
                </div>
                <div class="cp-form-group">
                    <label asp-for="Form.ExpectedReturnTime" class="cp-form-label">Expected Return Time <span class="required">*</span></label>
                    <input asp-for="Form.ExpectedReturnTime" type="time" class="cp-input" />
                    <span asp-validation-for="Form.ExpectedReturnTime" class="cp-form-error"></span>
                </div>
            </div>

            <div class="cp-section-title">Purpose &amp; Notes</div>
            <div class="cp-form-group">
                <label asp-for="Form.Purpose" class="cp-form-label">Purpose of Borrowing <span class="required">*</span></label>
                <textarea asp-for="Form.Purpose" class="cp-textarea" rows="3" placeholder="Be specific — the custodian uses this to prioritise competing requests."></textarea>
                <span asp-validation-for="Form.Purpose" class="cp-form-error"></span>
            </div>
            <div class="cp-form-group">
                <label asp-for="Form.AdditionalNotes" class="cp-form-label">Additional Notes</label>
                <textarea asp-for="Form.AdditionalNotes" class="cp-textarea" rows="2" placeholder="Optional remarks for the custodian."></textarea>
                <span asp-validation-for="Form.AdditionalNotes" class="cp-form-error"></span>
            </div>

            <div class="cp-section-title">Acknowledgements</div>
            <div class="cp-form-group">
                <label class="cp-check">
                    <input type="checkbox" asp-for="Form.AcknowledgeRules" />
                    I acknowledge the borrowing rules and accept accountability for damage, loss or late return of this equipment.
                </label>
            </div>
            <div class="cp-form-group">
                <label class="cp-check">
                    <input type="checkbox" asp-for="Form.AcknowledgeResponsibility" />
                    I understand that overdue items may suspend my borrowing privileges for the remainder of the term.
                </label>
            </div>

            <div class="cp-row-between">
                <a asp-controller="Reservations" asp-action="Available" class="cp-btn cp-btn-secondary">Back</a>
                <button type="submit" class="cp-btn cp-btn-success">Submit Reservation</button>
            </div>
        </form>
    </div>

    <div class="cp-stack">
        <div class="cp-card">
            <div class="cp-card-header">Selected Equipment</div>
            @if (Model.Equipment != null)
            {
                <dl class="cp-kv">
                    <dt>Equipment</dt><dd>@Model.Equipment.EquipmentName</dd>
                    <dt>Asset Code</dt><dd class="cp-mono">@Model.Equipment.AssetCode</dd>
                    <dt>Category</dt><dd>@Model.Equipment.CategoryName</dd>
                    @if (!string.IsNullOrEmpty(Model.Equipment.LocationName))
                    {
                        <dt>Location</dt><dd>@Model.Equipment.LocationName</dd>
                    }
                    <dt>Available</dt><dd>@Model.Equipment.AvailableUnits of @Model.Equipment.TotalQuantity units</dd>
                    @if (!string.IsNullOrWhiteSpace(Model.Equipment.ConditionName))
                    {
                        <dt>Condition</dt><dd><span class="@StatusBadge.Css(Model.Equipment.ConditionName.Trim().ToUpperInvariant().Replace(' ', '_'))">@Model.Equipment.ConditionName</span></dd>
                    }
                </dl>
            }
            else
            {
                <div class="cp-empty-state compact"><div class="cp-empty-state-text">Equipment summary unavailable.</div></div>
            }
        </div>

        <div class="cp-card">
            <div class="cp-card-header">Review Time</div>
            <div class="cp-stack">
                <div class="cp-cell-sub">Requests are normally reviewed within one working day. You will be notified once a decision is made.</div>
                <div class="cp-cell-sub">Cancellation window — you may cancel this request any time while it is still Pending or Approved.</div>
            </div>
        </div>
    </div>
</div>
