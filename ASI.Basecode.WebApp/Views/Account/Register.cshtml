@model RegisterViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Create Account";
}
<div class="cp-auth-card cp-auth-card-wide">
    <h1 class="cp-auth-title">Create Account</h1>
    <p class="cp-auth-subtitle">Register for CRAFT access</p>

    <form method="post" action="/Account/Register">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="cp-alert cp-alert-error"></div>

        <div class="row">
            <div class="col-md-6">
                <div class="cp-form-group">
                    <label class="cp-form-label" asp-for="FirstName">First Name <span class="required">*</span></label>
                    <input asp-for="FirstName" class="cp-input" placeholder="First name" required />
            <span asp-validation-for="FirstName" class="cp-field-error"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="cp-form-group">
                    <label class="cp-form-label" asp-for="LastName">Last Name <span class="required">*</span></label>
                    <input asp-for="LastName" class="cp-input" placeholder="Last name" required />
            <span asp-validation-for="LastName" class="cp-field-error"></span>
                </div>
            </div>
        </div>
        <div class="cp-form-group">
            <label class="cp-form-label" asp-for="AccountIdentifier">School ID / Employee ID <span class="required">*</span></label>
            <input asp-for="AccountIdentifier" class="cp-input" placeholder="e.g. 2023-104857" maxlength="20" autocomplete="off" required />
            <div class="cp-form-hint">4–20 characters: letters, digits and dashes (e.g. 2023-104857 or EMP-1001).</div>
            <span asp-validation-for="AccountIdentifier" class="cp-field-error"></span>
        </div>
        <div class="cp-form-group">
            <label class="cp-form-label" asp-for="SchoolEmail">School Email <span class="required">*</span></label>
            <input asp-for="SchoolEmail" type="email" class="cp-input" placeholder="your.name@university.edu.ph" required />
            <span asp-validation-for="SchoolEmail" class="cp-field-error"></span>
        </div>
        <div class="cp-form-group">
            <label class="cp-form-label" asp-for="RoleId">Role <span class="required">*</span></label>
            <select asp-for="RoleId" class="cp-select" required>
                <option value="">— Select role —</option>
                @foreach (var role in Model.RoleOptions)
                {
                    <option value="@role.Id">@role.Text</option>
                }
            </select>
            <span asp-validation-for="RoleId" class="cp-field-error"></span>
        </div>
        <div class="cp-form-group">
            <label class="cp-form-label" asp-for="DepartmentId">Department / Program <span class="required">*</span></label>
            <select asp-for="DepartmentId" class="cp-select" required>
                <option value="">— Select department —</option>
                @foreach (var department in Model.DepartmentOptions)
                {
                    <option value="@department.Id">@department.Text</option>
                }
            </select>
            <span asp-validation-for="DepartmentId" class="cp-field-error"></span>
        </div>
        <div class="cp-form-group">
            <label class="cp-form-label" asp-for="Password">Password <span class="required">*</span></label>
            <input asp-for="Password" type="password" class="cp-input" placeholder="Create a password" autocomplete="new-password" required />
            <span asp-validation-for="Password" class="cp-field-error"></span>
            <div class="cp-form-hint">At least 8 characters, with 1 uppercase letter and 1 number.</div>
        </div>
        <div class="cp-form-group">
            <label class="cp-form-label" asp-for="ConfirmPassword">Confirm Password <span class="required">*</span></label>
            <input asp-for="ConfirmPassword" type="password" class="cp-input" placeholder="Re-enter password" autocomplete="new-password" required />
            <span asp-validation-for="ConfirmPassword" class="cp-field-error"></span>
        </div>
        <details class="cp-form-group cp-privacy-notice">
            <summary class="cp-form-label">Data Privacy Notice (read before accepting)</summary>
            <div class="cp-form-hint">
                <p>In line with the Data Privacy Act of 2012 (RA 10173), CRAFT collects your name, School/Employee ID, school email, role and department, along with your reservation, borrowing and return history.</p>
                <p><strong>Purpose:</strong> to verify your identity, process equipment reservations, track borrowed items, and apply accountability for damage, loss or late returns.</p>
                <p><strong>Access:</strong> only authorised custodians and system administrators can view your records. Your data is not shared with third parties.</p>
                <p><strong>Retention:</strong> records are kept while your account is active and for as long as school records policy requires, then deleted or anonymised.</p>
                <p><strong>Your rights:</strong> you may access, correct or request deletion of your data, or withdraw consent, by contacting the system administrator.</p>
            </div>
        </details>
        <div class="cp-form-group">
            <label class="cp-form-hint cp-check-row">
                <input asp-for="PrivacyConsent" required />
                <span>I have read and accept the Data Privacy Notice above and consent to the processing of my information for equipment borrowing.</span>
            </label>
            <span asp-validation-for="PrivacyConsent" class="cp-field-error"></span>
        </div>
        <button type="submit" class="cp-btn cp-btn-primary cp-btn-block">Create Account</button>
    </form>

    <div class="cp-auth-divider">or</div>

    <p class="text-center cp-auth-footnote cp-auth-footnote--flush">
        Already have an account? <a href="/Account/Login" class="cp-auth-link">Sign In</a>
    </p>
</div>
