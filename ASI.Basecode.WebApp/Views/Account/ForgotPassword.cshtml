@model ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot Password";
}
<div class="cp-auth-card">
    <h1 class="cp-auth-title">Forgot Password</h1>
    <p class="cp-auth-subtitle">Enter your school email to receive a reset link</p>

    @if (Model.LinkSent)
    {
        <div class="cp-alert cp-alert-success">
            If that email is registered, a reset link valid for 24 hours has been issued.
        </div>
        @if (!string.IsNullOrEmpty(Model.GeneratedResetUrl))
        {
            <div class="cp-alert cp-alert-warning cp-break-all">
                <strong>Demo mode:</strong> email isn't configured, so the reset link is shown here. In production it's emailed.<br />
                <a href="@Model.GeneratedResetUrl" class="cp-auth-link">Open reset link</a>
            </div>
        }
    }
    else
    {
        <form method="post" action="/Account/ForgotPassword">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="cp-alert cp-alert-error"></div>

            <div class="cp-form-group">
                <label class="cp-form-label" asp-for="Email">School Email <span class="required">*</span></label>
                <input asp-for="Email" type="email" class="cp-input" placeholder="your.name@university.edu.ph" required />
            </div>
            <button type="submit" class="cp-btn cp-btn-primary cp-btn-block">Send Reset Link</button>
        </form>
    }

    <p class="text-center cp-auth-footnote">
        Remember your password? <a href="/Account/Login" class="cp-auth-link">Sign In</a>
    </p>
</div>
