@using ASI.Basecode.Services.ViewModelClasses
@model AnnouncementIndexViewModel
@{
    ViewData["Title"] = "Announcements";
    var audiences = new[] { ("STUDENT", "Students"), ("FACULTY", "Faculty"), ("TECHNICIAN", "Custodians"), ("ADMIN", "Administrators") };
    var chosen = Model.Form?.TargetRoles ?? new List<string>();
    var items = Model.Page?.Items ?? Model.Items;
    var categories = new[] { ("GENERAL", "General"), ("MAINTENANCE", "Maintenance"), ("RULE_CHANGE", "Rule change") };
}

<div class="cp-page-header">
    <div>
        <h1 class="cp-page-title">Announcements</h1>
        <p class="cp-page-subtitle">Broadcast to roles. Recipients get an in-app notification (if they allow announcements) and a banner on their dashboard until it expires.</p>
    </div>
</div>

<div class="cp-grid-2">
    <div class="cp-card">
        <div class="cp-card-header">Published</div>
        @if (items.Count == 0)
        {
            <div class="cp-empty-state compact"><div class="cp-empty-state-text">No announcements yet.</div></div>
        }
        else
        {
            <div class="cp-stack">
                @foreach (var a in items)
                {
                    <article class="cp-card">
                        <div class="cp-row-between">
                            <div>
                                <div class="cp-cell-name">@a.Title</div>
                                <div class="cp-cell-sub">@a.AudienceLabel &middot; @a.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy") @(a.CreatedByName == null ? "" : "· " + a.CreatedByName)</div>
                            </div>
                            <div class="cp-page-actions">
                                <span class="cp-badge cp-badge-info">@(a.Category == "RULE_CHANGE" ? "Rule change" : a.Category == "MAINTENANCE" ? "Maintenance" : "General")</span>
                                <span class="@StatusBadge.Css(a.IsActive ? "ACTIVE" : "EXPIRED")">@(a.IsActive ? (a.ExpiresAtUtc.HasValue ? "Until " + a.ExpiresAtUtc.Value.ToLocalTime().AddDays(-1).ToString("dd MMM") : "Active") : "Expired")</span>
                                <form method="post" asp-action="Delete" asp-route-id="@a.AnnouncementId" onsubmit="return confirm('Delete this announcement?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="cp-btn cp-btn-danger cp-btn-sm">Delete</button>
                                </form>
                            </div>
                        </div>
                        <p class="cp-form-hint" style="white-space:pre-line">@a.Body</p>
                    </article>
                }
            </div>
        }
    </div>

    <div class="cp-card">
        <div class="cp-card-header">New announcement</div>
        <form method="post" asp-action="Publish">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="cp-validation-summary"></div>
            <div class="cp-form-group">
                <label class="cp-form-label" for="annCategory">Type <span class="required">*</span></label>
                <select id="annCategory" name="Category" class="cp-select" required>
                    @foreach (var (code, label) in categories)
                    {
                        <option value="@code" selected="@(Model.Form?.Category == code)">@label</option>
                    }
                </select>
            </div>
            <div class="cp-form-group">
                <label class="cp-form-label" for="annTitle">Title <span class="required">*</span></label>
                <input id="annTitle" name="Title" value="@Model.Form?.Title" class="cp-input" maxlength="200" required placeholder="e.g. Property Office closed on Friday" />
            </div>
            <div class="cp-form-group">
                <label class="cp-form-label" for="annBody">Message <span class="required">*</span></label>
                <textarea id="annBody" name="Body" class="cp-textarea" rows="5" maxlength="2000" required>@Model.Form?.Body</textarea>
            </div>
            <fieldset class="cp-form-group" style="border:0;padding:0">
                <legend class="cp-form-label">Audience <span class="required">*</span></legend>
                <div style="display:flex;flex-wrap:wrap;gap:12px">
                    @foreach (var (code, label) in audiences)
                    {
                        <label>
                            <input type="checkbox" name="TargetRoles" value="@code" checked="@(chosen.Contains(code))" /> @label
                        </label>
                    }
                </div>
            </fieldset>
            <div class="cp-form-group">
                <label class="cp-form-label" for="annExpires">Show until (optional)</label>
                <input id="annExpires" type="date" name="ExpiresOn" value="@(Model.Form?.ExpiresOn?.ToString("yyyy-MM-dd"))" class="cp-input" />
                <div class="cp-form-hint">Leave empty to keep it on dashboards until you delete it.</div>
            </div>
            <button type="submit" class="cp-btn cp-btn-primary">Publish</button>
        </form>
    </div>
</div>

@await Html.PartialAsync("_Pagination", ASI.Basecode.WebApp.Models.PaginationModel.From(Model.Page))
