@model ProfileViewModel
@{
    var isCustodian = string.Equals(Model.RoleCode, "TECHNICIAN", System.StringComparison.OrdinalIgnoreCase);
    var isAdmin = string.Equals(Model.RoleCode, "ADMIN", System.StringComparison.OrdinalIgnoreCase);
    var idLabel = isCustodian ? "Employee ID" : (isAdmin ? "Admin ID" : "School ID");
    var departmentLabel = isCustodian ? "Assigned Location" : "College / Department";
    var initials = ((Model.FirstName?.Length > 0 ? Model.FirstName.Substring(0, 1) : "") +
                    (Model.LastName?.Length > 0 ? Model.LastName.Substring(0, 1) : "")).ToUpperInvariant();
}

<div class="cp-stack">
    <div class="cp-card">
        <div class="cp-profile-header">
            <div class="cp-profile-idblock">
                <div class="cp-profile-photo">
                    @if (!string.IsNullOrWhiteSpace(Model.ProfileImagePath))
                    {
                        <img src="@Model.ProfileImagePath" alt="Profile photo for @Model.FullName" class="cp-avatar-lg cp-avatar-photo" />
                    }
                    else
                    {
                        <div class="cp-avatar-lg">@(string.IsNullOrWhiteSpace(initials) ? "U" : initials)</div>
                    }
                    <form method="post" action="/Profile/UploadPhoto" enctype="multipart/form-data" class="cp-profile-photo-form">
                        @Html.AntiForgeryToken()
                        <input id="profilePhoto" name="profilePhoto" type="file" accept=".jpg,.jpeg,.png,.webp,.gif,image/jpeg,image/png,image/webp,image/gif" aria-label="Choose profile photo" required />
                        <button type="submit" class="cp-btn cp-btn-secondary cp-btn-sm">Upload</button>
                        <span class="cp-form-hint">JPG, PNG, WEBP or GIF, up to 5 MB.</span>
                    </form>
                </div>
                <div class="cp-stack">
                    <div>
                        <div class="cp-profile-name">@Model.FullName</div>
                        <div class="cp-profile-meta">@Model.SchoolEmail</div>
                    </div>
                    <div>
                        <span class="cp-badge cp-badge-info">@Model.RoleName</span>
                        <span class="@StatusBadge.AccountCss(Model.AccountStatusCode)">@Model.AccountStatusDescription</span>
                    </div>
                </div>
            </div>
            <div class="cp-profile-stats">
                <div><div class="cp-profile-stat-value">@Model.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</div><div class="cp-profile-stat-label">Member since</div></div>
                <div><div class="cp-profile-stat-value">@Model.ActiveBorrowings</div><div class="cp-profile-stat-label">Active borrowings</div></div>
                <div><div class="cp-profile-stat-value">@Model.CompletedBorrowings</div><div class="cp-profile-stat-label">Completed</div></div>
                <div><div class="cp-profile-stat-value" style="@(Model.OverdueItems > 0 ? "color:var(--color-error)" : null)">@Model.OverdueItems</div><div class="cp-profile-stat-label">Overdue</div></div>
            </div>
        </div>
    </div>

    <div class="cp-grid-2">
        <div class="cp-stack">
            <div class="cp-card">
                <div class="cp-card-header">@(isCustodian ? "Staff Information" : (isAdmin ? "Administrator Information" : "School Information")) <span class="cp-cell-sub">Maintained by the Administrator in User Management</span></div>
                <dl class="cp-kv">
                    <dt>@idLabel</dt><dd><span class="cp-mono">@Model.AccountIdentifier</span></dd>
                    <dt>@departmentLabel</dt><dd>@(Model.DepartmentName ?? "-")</dd>
                </dl>
            </div>

            <form method="post" action="/Profile/SaveContact" class="cp-stack">
                @Html.AntiForgeryToken()
                <div class="cp-card">
                    <div class="cp-card-header">Contact Information <span class="cp-cell-sub">Used for reservation and due-date notices</span></div>
                    <div class="cp-profile-grid">
                        <div class="cp-form-group">
                            <label class="cp-form-label" for="ContactNumber">Contact Number <span class="required">*</span></label>
                            <input id="ContactNumber" name="ContactNumber" value="@Model.ContactNumber" class="cp-input" placeholder="+63 917 555 0142" required />
                        </div>
                        <div class="cp-form-group">
                            <label class="cp-form-label" for="AlternateContact">Alternate Contact</label>
                            <input id="AlternateContact" name="AlternateContact" value="@Model.AlternateContact" class="cp-input" placeholder="Optional" />
                        </div>
                    </div>
                    <div class="cp-form-hint">Notifications and password resets are sent to your school email.</div>
                </div>

                <div class="cp-card">
                    <div class="cp-card-header">Notification Preferences <span class="cp-cell-sub">Choose what CRAFT notifies you about</span></div>
                    <label class="cp-pref-row">
                        <div><div class="cp-pref-title">Reservation decisions</div><div class="cp-pref-sub">Email me when a request is approved, rejected or marked ready for pickup.</div></div>
                        <input type="checkbox" name="NotifyReservationUpdates" value="true" @(Model.NotifyReservationUpdates ? "checked" : "") />
                    </label>
                    <label class="cp-pref-row">
                        <div><div class="cp-pref-title">Due-date reminders</div><div class="cp-pref-sub">Send a reminder before each due date.</div></div>
                        <input type="checkbox" name="NotifyDueReminders" value="true" @(Model.NotifyDueReminders ? "checked" : "") />
                    </label>
                    <label class="cp-pref-row">
                        <div><div class="cp-pref-title">Overdue alerts</div><div class="cp-pref-sub">Keep alerting me until overdue equipment is returned.</div></div>
                        <input type="checkbox" name="NotifyOverdueAlerts" value="true" @(Model.NotifyOverdueAlerts ? "checked" : "") />
                    </label>
                    <label class="cp-pref-row">
                        <div><div class="cp-pref-title">Return confirmations</div><div class="cp-pref-sub">Notify me once a return has been inspected and closed.</div></div>
                        <input type="checkbox" name="NotifyReturnConfirmations" value="true" @(Model.NotifyReturnConfirmations ? "checked" : "") />
                    </label>
                    <label class="cp-pref-row">
                        <div><div class="cp-pref-title">Equipment announcements</div><div class="cp-pref-sub">Occasional notices about newly available equipment.</div></div>
                        <input type="checkbox" name="NotifyAnnouncements" value="true" @(Model.NotifyAnnouncements ? "checked" : "") />
                    </label>
                </div>

                <div class="cp-profile-actions">
                    <button type="submit" class="cp-btn cp-btn-primary">Save Changes</button>
                    <a href="/Profile" class="cp-btn cp-btn-secondary">Discard Changes</a>
                </div>
            </form>
        </div>

        <div class="cp-stack">
            <form method="post" action="/Profile/ChangePassword">
                @Html.AntiForgeryToken()
                <div class="cp-card">
                    <div class="cp-card-header">Password &amp; Security <span class="cp-cell-sub">Changing your password signs out every other device</span></div>
                    <div class="cp-form-group">
                        <label class="cp-form-label" for="CurrentPassword">Current Password <span class="required">*</span></label>
                        <input id="CurrentPassword" name="CurrentPassword" type="password" class="cp-input" autocomplete="current-password" required />
                    </div>
                    <div class="cp-form-group">
                        <label class="cp-form-label" for="NewPassword">New Password <span class="required">*</span></label>
                        <input id="NewPassword" name="NewPassword" type="password" class="cp-input" autocomplete="new-password" required />
                        <div class="cp-form-hint">At least 8 characters with one number and one uppercase letter.</div>
                    </div>
                    <div class="cp-form-group">
                        <label class="cp-form-label" for="ConfirmPassword">Confirm New Password <span class="required">*</span></label>
                        <input id="ConfirmPassword" name="ConfirmPassword" type="password" class="cp-input" autocomplete="new-password" required />
                    </div>
                    <button type="submit" class="cp-btn cp-btn-primary">Update Password</button>
                </div>
            </form>
        </div>
    </div>
</div>
