@using ASI.Basecode.Services.ViewModelClasses
@model SettingsIndexViewModel
@{
    ViewData["Title"] = "System Settings";
}

<div class="cp-page-header">
    <div>
        <h1 class="cp-page-title">System Settings</h1>
        <p class="cp-page-subtitle">Borrowing policy, equipment categories, and locations.</p>
    </div>
</div>

<div class="cp-stack">
    <div class="cp-grid-2">
        <div class="cp-card" id="policy">
            <div class="cp-card-header">Borrowing Policy <span class="cp-cell-sub">Current version @Model.Policy.VersionNumber</span></div>
            <form asp-action="SavePolicy" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Policy.PolicyVersionId" />
                <div class="cp-profile-grid">
                    <div class="cp-form-group">
                        <label asp-for="Policy.MaxBorrowDurationDays" class="cp-form-label">Max Borrow Days</label>
                        <input asp-for="Policy.MaxBorrowDurationDays" type="number" min="1" max="365" class="cp-input" />
                    </div>
                    <div class="cp-form-group">
                        <label asp-for="Policy.MaxUnitsPerBorrower" class="cp-form-label">Max Units per Reservation</label>
                        <input asp-for="Policy.MaxUnitsPerBorrower" type="number" min="1" max="100" class="cp-input" />
                        <div class="cp-form-hint">Most units one borrower may request at once.</div>
                    </div>
                    <div class="cp-form-group">
                        <label asp-for="Policy.MaxActiveBorrowingUnits" class="cp-form-label">Max Open Requests per Borrower</label>
                        <input asp-for="Policy.MaxActiveBorrowingUnits" type="number" min="1" max="100" class="cp-input" />
                        <div class="cp-form-hint">Pending or approved reservations a borrower may have at the same time.</div>
                    </div>
                    <div class="cp-form-group">
                        <label asp-for="Policy.FacultyMaxBorrowDays" class="cp-form-label">Faculty Max Borrow Days</label>
                        <input asp-for="Policy.FacultyMaxBorrowDays" type="number" min="1" max="365" class="cp-input" />
                        <div class="cp-form-hint">Must be at least the student max borrow days.</div>
                    </div>
                    <div class="cp-form-group">
                        <label asp-for="Policy.ReservationLeadTimeDays" class="cp-form-label">Reservation Lead Time (days)</label>
                        <input asp-for="Policy.ReservationLeadTimeDays" type="number" min="0" max="30" class="cp-input" />
                        <div class="cp-form-hint">Minimum days between submitting a request and pickup.</div>
                    </div>
                    <div class="cp-form-group">
                        <label asp-for="Policy.MaxAdvanceBookingDays" class="cp-form-label">Max Advance Booking (days)</label>
                        <input asp-for="Policy.MaxAdvanceBookingDays" type="number" min="1" max="365" class="cp-input" />
                        <div class="cp-form-hint">How far ahead a pickup can be booked.</div>
                    </div>
                    <div class="cp-form-group">
                        <label asp-for="Policy.OverdueGracePeriodMinutes" class="cp-form-label">Overdue Grace (min)</label>
                        <input asp-for="Policy.OverdueGracePeriodMinutes" type="number" min="0" max="1440" class="cp-input" />
                    </div>
                    <div class="cp-form-group">
                        <label asp-for="Policy.LowStockThreshold" class="cp-form-label">Low Stock Threshold</label>
                        <input asp-for="Policy.LowStockThreshold" type="number" min="0" max="10000" class="cp-input" />
                    </div>
                </div>
                <label class="cp-form-hint">
                    <input type="checkbox" asp-for="Policy.BlockReservationWhenOverdue" />
                    Block reservations when borrower has overdue items
                </label>
                <div class="cp-profile-actions">
                    <button type="submit" class="cp-btn cp-btn-success">Publish New Policy Version</button>
                </div>
            </form>
        </div>

        <div class="cp-card cp-card-flush">
            <div class="cp-card-header">Policy History</div>
            <div class="cp-table-wrap">
                <table class="cp-table">
                    <thead>
                        <tr><th>Version</th><th>Effective From</th><th>Current</th><th>Max Days</th><th>Units / Reservation</th><th>Open Requests</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.PolicyHistory)
                        {
                            <tr>
                                <td class="cp-mono">@p.VersionNumber</td>
                                <td>@p.EffectiveFromUtc.ToLocalTime().ToString("dd MMM yyyy")</td>
                                <td>@(p.IsCurrent ? "Yes" : "—")</td>
                                <td>@p.MaxBorrowDurationDays</td>
                                <td>@p.MaxUnitsPerBorrower</td>
                                <td>@p.MaxActiveBorrowingUnits</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="cp-card cp-card-flush" id="categories">
        <div class="cp-card-header">Equipment Categories</div>
        <form asp-action="AddCategory" method="post" class="cp-filter-bar">
            @Html.AntiForgeryToken()
            <input name="code" class="cp-input" placeholder="Code (e.g. LAPTOP)" aria-label="Category code" required minlength="2" maxlength="50" pattern="[A-Za-z0-9_\-]{2,50}" title="2-50 letters, digits, dashes or underscores" style="text-transform:uppercase" />
            <input name="name" class="cp-input" placeholder="Category name (e.g. Laptops)" aria-label="Category name" required maxlength="200" />
            <button type="submit" class="cp-btn cp-btn-success cp-btn-sm">Add</button>
        </form>
        <div class="cp-table-wrap">
            <table class="cp-table">
                <thead><tr><th>Code</th><th>Name</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (var c in Model.Categories)
                    {
                        <tr>
                            <td class="cp-mono">@c.CategoryCode</td>
                            <td>@c.CategoryName</td>
                            <td>
                                <form asp-action="DeleteCategory" asp-route-id="@c.EquipmentCategoryId" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="cp-btn cp-btn-danger cp-btn-sm" data-confirm="Delete the category “@c.CategoryName”? This can't be undone." onclick="return confirm(this.dataset.confirm);">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="cp-card cp-card-flush" id="locations">
        <div class="cp-card-header">Locations</div>
        <form asp-action="AddLocation" method="post" class="cp-filter-bar">
            @Html.AntiForgeryToken()
            <input name="code" class="cp-input" placeholder="Code (e.g. LIB-2F)" aria-label="Location code" required minlength="2" maxlength="50" pattern="[A-Za-z0-9_\-]{2,50}" title="2-50 letters, digits, dashes or underscores" style="text-transform:uppercase" />
            <input name="name" class="cp-input" placeholder="Location name" aria-label="Location name" required maxlength="200" />
            <label class="cp-form-hint">
                <input type="checkbox" name="isPickup" value="true" /> Pickup point
            </label>
            <button type="submit" class="cp-btn cp-btn-success cp-btn-sm">Add</button>
        </form>
        <div class="cp-table-wrap">
            <table class="cp-table">
                <thead><tr><th>Code</th><th>Name</th><th>Pickup</th><th>Active</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (var l in Model.Locations)
                    {
                        <tr>
                            <td class="cp-mono">@l.LocationCode</td>
                            <td>@l.LocationName</td>
                            <td>@(l.IsPickupLocation ? "Yes" : "No")</td>
                            <td>@(l.IsActive ? "Yes" : "No")</td>
                            <td>
                                <form asp-action="DeleteLocation" asp-route-id="@l.LocationId" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="cp-btn cp-btn-danger cp-btn-sm" data-confirm="Delete the location “@l.LocationName”? This can't be undone." onclick="return confirm(this.dataset.confirm);">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
