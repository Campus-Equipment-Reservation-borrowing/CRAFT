@using ASI.Basecode.Services.ViewModelClasses
@model ActiveBorrowingsIndexViewModel
@{
    ViewData["Title"] = "Active Borrowings";
}

<div class="cp-page-header">
    <div>
        <h1 class="cp-page-title">Active Borrowings</h1>
        <p class="cp-page-subtitle">Equipment currently released to borrowers.</p>
    </div>
</div>

<div class="cp-filter-bar">
    <form method="get" asp-action="Borrowings" style="display:contents;">
        <input type="text" name="search" value="@Model.Search" class="cp-input" placeholder="Search by borrower, equipment or transaction number..." />
        <button type="submit" class="cp-btn cp-btn-secondary cp-btn-sm">Apply</button>
        <a asp-action="Borrowings" class="cp-btn cp-btn-secondary cp-btn-sm">Clear</a>
    </form>
</div>

@if (!Model.Page.Items.Any())
{
    <div class="cp-empty-state compact">
        <div class="cp-empty-state-text">No active borrowings.</div>
    </div>
}
else
{
    <div class="cp-table-wrap">
        <table class="cp-table">
            <thead>
                <tr>
                    <th>Transaction #</th>
                    <th>Borrower</th>
                    <th>Equipment</th>
                    <th class="text-center">Qty</th>
                    <th>Released</th>
                    <th>Due</th>
                    <th>Status</th>
                    <th>Released By</th>
                    <th>Inspection</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model.Page.Items)
                {
                    <tr>
                        <td class="cp-mono">@b.TransactionNumber</td>
                        <td>@b.BorrowerName</td>
                        <td>
                            <div class="cp-cell-name">@b.EquipmentName</div>
                            <div class="cp-cell-sub cp-mono">@b.AssetCode</div>
                        </td>
                        <td class="text-center cp-mono">@b.ReleasedQuantity</td>
                        <td>@b.ReleasedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td>
                        <td>@b.DueAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td>
                        <td>
                            @if (b.IsOverdue)
                            {
                                <span class="@StatusBadge.Css("OVERDUE")">Overdue @b.DaysOverdue d</span>
                            }
                            else
                            {
                                <span class="@StatusBadge.Css(b.StatusCode)">@b.StatusDescription</span>
                            }
                        </td>
                        <td>@(b.ReleasedBy ?? "—")</td>
                        <td>@b.InspectionStatus</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.Page != null && Model.Page.TotalPages > 1)
{
    <div class="cp-pagination">
        <span class="cp-pagination-info">Page @Model.Page.Page of @Model.Page.TotalPages (@Model.Page.TotalCount records)</span>
        <ul class="cp-pagination-list">
            <li class="@(Model.Page.HasPrevious ? "" : "disabled")">
                <a asp-action="Borrowings" asp-route-search="@Model.Search" asp-route-page="@(Model.Page.Page - 1)">‹</a>
            </li>
            @for (var p = 1; p <= Model.Page.TotalPages; p++)
            {
                <li class="@(p == Model.Page.Page ? "active" : "")">
                    <a asp-action="Borrowings" asp-route-search="@Model.Search" asp-route-page="@p">@p</a>
                </li>
            }
            <li class="@(Model.Page.HasNext ? "" : "disabled")">
                <a asp-action="Borrowings" asp-route-search="@Model.Search" asp-route-page="@(Model.Page.Page + 1)">›</a>
            </li>
        </ul>
    </div>
}