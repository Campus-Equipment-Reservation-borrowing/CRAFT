@using ASI.Basecode.Services.ViewModelClasses
@model ReleaseFormViewModel
@{
    ViewData["Title"] = "Equipment Release";
}
@{
    var ctx = ViewBag.Context as ReleaseContextViewModel;
}

<div class="cp-page-header">
    <div>
        <partial name="_Breadcrumb" model='new[] { ("Reservations", "/Custodian/Reservations") }' />
        <h1 class="cp-page-title">Equipment Release</h1>
        <p class="cp-page-subtitle">Release approved equipment to the borrower.</p>
    </div>
</div>

<div class="cp-stack">
    @if (ctx != null)
    {
        <div class="cp-card">
            <div class="cp-card-header">Reservation Summary</div>
            <dl class="cp-kv">
                <dt>Reservation #</dt><dd class="cp-mono">@ctx.ReservationNumber</dd>
                <dt>Borrower</dt><dd>@ctx.BorrowerName <span class="cp-cell-sub">@ctx.BorrowerRole</span></dd>
                <dt>Equipment</dt><dd>@ctx.EquipmentName</dd>
                <dt>Asset Code</dt><dd class="cp-mono">@ctx.AssetCode</dd>
                <dt>Category</dt><dd>@ctx.CategoryName</dd>
                <dt>Pickup Point</dt><dd>@(ctx.PickupLocationName ?? "—")</dd>
                <dt>Remaining to Release</dt><dd class="cp-mono">@ctx.ApprovedQuantity</dd>
                @if (ctx.AlreadyReleasedQuantity > 0)
                {
                    <dt>Already Released</dt><dd class="cp-mono">@ctx.AlreadyReleasedQuantity</dd>
                }
                <dt>Expected Return</dt><dd>@ctx.ExpectedReturnAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>
            </dl>
        </div>
    }

    <div class="cp-card">
        <form asp-action="Release" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReservationId" />
            <div asp-validation-summary="ModelOnly" class="cp-validation-summary"></div>

            <div class="cp-grid-2">
                <div class="cp-form-group">
                    <label asp-for="ReleasedQuantity" class="cp-form-label">Released Quantity <span class="required">*</span></label>
                    <input asp-for="ReleasedQuantity" type="number" min="1" class="cp-input" />
                </div>
                <div class="cp-form-group">
                    <label asp-for="ReleaseConditionId" class="cp-form-label">Condition at Release <span class="required">*</span></label>
                    <select asp-for="ReleaseConditionId" class="cp-select" asp-items="@(ViewBag.ConditionOptions as SelectList)"></select>
                </div>
            </div>

            <div class="cp-form-group">
                <label asp-for="ReleaseNotes" class="cp-form-label">Release Notes</label>
                <textarea asp-for="ReleaseNotes" class="cp-textarea" rows="3" placeholder="Accessories issued, condition remarks..."></textarea>
            </div>

            <div class="cp-page-actions">
                <a asp-action="Reservations" class="cp-btn cp-btn-secondary">Cancel</a>
                <button type="submit" class="cp-btn cp-btn-success">Release Equipment</button>
            </div>
        </form>
    </div>
</div>
