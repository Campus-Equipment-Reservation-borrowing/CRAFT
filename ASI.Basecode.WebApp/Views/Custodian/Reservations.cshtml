@using ASI.Basecode.Services.ViewModelClasses
@model CustodianReservationsIndexViewModel
@{
    ViewData["Title"] = "Reservation Management";
}

<div class="cp-page-header">
    <div>
        <h1 class="cp-page-title">Reservation Management</h1>
        <p class="cp-page-subtitle">Review, approve or reject borrower reservations.</p>
    </div>
</div>

<div class="cp-filter-bar">
    <form method="get" asp-action="Reservations" style="display:contents;">
        <input type="text" name="search" value="@Model.Search" class="cp-input" placeholder="Search by borrower, equipment or reservation number..." />
        <select name="status" class="cp-select" asp-items="@(ViewBag.StatusOptions as SelectList)"></select>
        <button type="submit" class="cp-btn cp-btn-secondary cp-btn-sm">Apply</button>
        <a asp-action="Reservations" class="cp-btn cp-btn-secondary cp-btn-sm">Clear</a>
    </form>
</div>

@if (!Model.Page.Items.Any())
{
    <div class="cp-empty-state compact">
        <div class="cp-empty-state-text">No reservations found.</div>
    </div>
}
else
{
    <div class="cp-table-wrap">
        <table class="cp-table">
            <thead>
                <tr>
                    <th>Reservation #</th>
                    <th>Borrower</th>
                    <th>Equipment</th>
                    <th class="text-center">Qty</th>
                    <th>Pickup Point</th>
                    <th>Status</th>
                    <th>Custodian</th>
                    <th>Submitted</th>
                    <th>Start / Due</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Page.Items)
                {
                    var claimable = r.AssignedCustodianUserId == null && (r.StatusCode == "PENDING" || r.StatusCode == "APPROVED");
                    <tr>
                        <td class="cp-mono">@r.ReservationNumber</td>
                        <td>@r.BorrowerName</td>
                        <td>
                            <div class="cp-cell-name">@r.EquipmentName</div>
                            <div class="cp-cell-sub cp-mono">@r.AssetCode</div>
                        </td>
                        <td class="text-center cp-mono">@r.RequestedQuantity</td>
                        <td>@(r.PickupLocationName ?? "—")</td>
                        <td>
                            <span class="@StatusBadge.Css(r.StatusCode)">@r.StatusDescription</span>
                        </td>
                        <td>
                            @if (r.AssignedCustodianName == null)
                            {
                                <span class="cp-badge cp-badge-neutral" title="Not routed to a custodian yet">Shared pool</span>
                            }
                            else
                            {
                                @r.AssignedCustodianName
                            }
                        </td>
                        <td>@r.SubmittedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td>
                        <td>@r.RequestedStartAtUtc.ToLocalTime().ToString("dd MMM") – @r.ExpectedReturnAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td>
                        <td class="text-center">
                            @if (claimable && User.IsInRole("TECHNICIAN"))
                            {
                                <form method="post" asp-action="Claim" asp-route-id="@r.ReservationId" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="cp-btn cp-btn-primary cp-btn-sm">Assign to me</button>
                                </form>
                            }
                            <a asp-action="Review" asp-route-id="@r.ReservationId" class="cp-btn cp-btn-secondary cp-btn-sm">Review</a>
                            @if (r.StatusCode == "APPROVED" || r.StatusCode == "PARTIALLY_RELEASED")
                            {
                                <a asp-action="Release" asp-route-id="@r.ReservationId" class="cp-btn cp-btn-success cp-btn-sm">Release</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.Page != null && Model.Page.TotalPages > 1)
{
    <div class="cp-pagination">
        <span class="cp-pagination-info">Page @Model.Page.Page of @Model.Page.TotalPages (@Model.Page.TotalCount records)</span>
        <ul class="cp-pagination-list">
            <li class="@(Model.Page.HasPrevious ? "" : "disabled")">
                <a asp-action="Reservations" asp-route-search="@Model.Search" asp-route-status="@Model.StatusId" asp-route-page="@(Model.Page.Page - 1)">‹</a>
            </li>
            @for (var p = 1; p <= Model.Page.TotalPages; p++)
            {
                <li class="@(p == Model.Page.Page ? "active" : "")">
                    <a asp-action="Reservations" asp-route-search="@Model.Search" asp-route-status="@Model.StatusId" asp-route-page="@p">@p</a>
                </li>
            }
            <li class="@(Model.Page.HasNext ? "" : "disabled")">
                <a asp-action="Reservations" asp-route-search="@Model.Search" asp-route-status="@Model.StatusId" asp-route-page="@(Model.Page.Page + 1)">›</a>
            </li>
        </ul>
    </div>
}