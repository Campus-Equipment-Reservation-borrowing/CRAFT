@using ASI.Basecode.Services.ViewModelClasses
@model ReservationReviewViewModel
@{
    ViewData["Title"] = "Reservation Review";
}

<div class="cp-page-header">
    <div>
        <partial name="_Breadcrumb" model='new[] { ("Reservations", "/Custodian/Reservations") }' />
        <h1 class="cp-page-title">Reservation Review</h1>
        <p class="cp-page-subtitle">Check the request, then approve or reject it.</p>
    </div>
    @if (Model.CanClaim && User.IsInRole("TECHNICIAN"))
    {
        <div class="cp-page-actions">
            <form method="post" asp-action="Claim" asp-route-id="@Model.ReservationId" asp-route-returnTo="review">
                @Html.AntiForgeryToken()
                <button type="submit" class="cp-btn cp-btn-primary cp-btn-sm">Assign to me</button>
            </form>
        </div>
    }
</div>

<div class="cp-grid-2">
    <div class="cp-stack">
        <div class="cp-card">
            <div class="cp-card-header">Reservation Details</div>
            <dl class="cp-kv">
                <dt>Reservation #</dt><dd class="cp-mono">@Model.ReservationNumber</dd>
                <dt>Status</dt><dd><span class="@StatusBadge.Css(Model.StatusCode)">@Model.StatusDescription</span></dd>
                <dt>Custodian</dt>
                <dd>
                    @if (Model.AssignedCustodianName == null)
                    {
                        <span class="cp-badge cp-badge-neutral" title="Not routed to a custodian yet">Shared pool</span>
                    }
                    else
                    {
                        @Model.AssignedCustodianName
                    }
                </dd>
                <dt>Submitted</dt><dd>@Model.SubmittedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>
                <dt>Requested</dt><dd class="cp-mono">@Model.RequestedQuantity</dd>
                <dt>Approved</dt><dd class="cp-mono">@Model.ApprovedQuantity</dd>
                <dt>Held</dt><dd class="cp-mono">@Model.HeldQuantity</dd>
                <dt>Start</dt><dd>@Model.RequestedStartAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>
                <dt>Expected Return</dt><dd>@Model.ExpectedReturnAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>
                <dt>Purpose</dt><dd>@(Model.Purpose ?? "—")</dd>
            </dl>
        </div>

        <div class="cp-card">
            <div class="cp-card-header">Borrower</div>
            <dl class="cp-kv">
                <dt>Name</dt><dd>@Model.BorrowerName</dd>
                <dt>Role</dt><dd>@Model.BorrowerRole</dd>
                <dt>Department</dt><dd>@(Model.BorrowerDepartment ?? "—")</dd>
                <dt>Email</dt><dd>@Model.BorrowerEmail</dd>
            </dl>
        </div>

        <div class="cp-card">
            <div class="cp-card-header">Equipment</div>
            <dl class="cp-kv">
                <dt>Name</dt><dd>@Model.EquipmentName</dd>
                <dt>Asset Code</dt><dd class="cp-mono">@Model.AssetCode</dd>
                <dt>Category</dt><dd>@Model.CategoryName</dd>
                <dt>Location</dt><dd>@(Model.LocationName ?? "—")</dd>
                <dt>Pickup Point</dt><dd>@(Model.PickupLocationName ?? "—")</dd>
            </dl>
        </div>
    </div>

    <div class="cp-stack">
        <div class="cp-card">
            <div class="cp-card-header">Decision</div>
            @if (Model.CanApprove || Model.CanReject)
            {
                <div class="cp-stack">
                    <form asp-action="Approve" asp-route-id="@Model.ReservationId" method="post">
                        @Html.AntiForgeryToken()
                        <div class="cp-form-group">
                            <label class="cp-form-label">Approval notes (optional)</label>
                            <textarea name="notes" class="cp-textarea" rows="2" maxlength="500"></textarea>
                        </div>
                        <button type="submit" class="cp-btn cp-btn-success">Approve Reservation</button>
                    </form>
                    <form asp-action="Reject" asp-route-id="@Model.ReservationId" method="post">
                        @Html.AntiForgeryToken()
                        <div class="cp-form-group">
                            <label class="cp-form-label">Rejection reason (required)</label>
                            <textarea name="reason" class="cp-textarea" rows="2" maxlength="500" required></textarea>
                        </div>
                        <button type="submit" class="cp-btn cp-btn-danger">Reject Reservation</button>
                    </form>
                </div>
            }
            else
            {
                <div class="cp-stack">
                    <p class="cp-cell-sub">A decision has already been made on this reservation.</p>
                    @if (Model.StatusCode == "APPROVED" || Model.StatusCode == "PARTIALLY_RELEASED")
                    {
                        <div>
                            <a asp-action="Release" asp-route-id="@Model.ReservationId" class="cp-btn cp-btn-success">
                                @(Model.StatusCode == "PARTIALLY_RELEASED" ? "Release Remaining Units" : "Release Equipment")
                            </a>
                        </div>
                    }
                </div>
            }
        </div>

        @if (Model.StatusCode is "PENDING" or "APPROVED" or "READY_FOR_RELEASE" or "PARTIALLY_RELEASED")
        {
            <details class="cp-card">
                <summary class="cp-cell-name">
                    @(Model.StatusCode == "PARTIALLY_RELEASED" ? "Close out the unreleased units" : "Cancel or expire this reservation")
                </summary>
                <form asp-action="Cancel" asp-route-id="@Model.ReservationId" method="post" class="cp-mt-12">
                    @Html.AntiForgeryToken()
                    <div class="cp-form-group">
                        <label class="cp-form-label" for="cancelReason">Reason (required, sent to the borrower)</label>
                        <textarea id="cancelReason" name="reason" class="cp-textarea" rows="2" maxlength="500" required placeholder="e.g. Borrower did not pick up within the window."></textarea>
                    </div>
                    <button type="submit" class="cp-btn cp-btn-danger cp-btn-sm">Cancel and release held units</button>
                    @if (Model.StatusCode != "PARTIALLY_RELEASED")
                    {
                        <button type="submit" class="cp-btn cp-btn-secondary cp-btn-sm" asp-action="Expire" asp-route-id="@Model.ReservationId">Mark as expired (no-show)</button>
                    }
                </form>
            </details>
        }
    </div>
</div>
