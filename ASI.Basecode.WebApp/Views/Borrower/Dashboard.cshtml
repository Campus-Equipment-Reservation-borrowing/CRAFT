@model BorrowerDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var greeting = DateTime.Now.Hour < 12 ? "Good morning" : (DateTime.Now.Hour < 18 ? "Good afternoon" : "Good evening");
}

<div class="cp-page-header">
    <div>
        <h1 class="cp-page-title">Dashboard</h1>
        <p class="cp-page-subtitle">Your equipment activity for A.Y. 2026-2027, 1st Semester.</p>
    </div>
</div>

@await Component.InvokeAsync("AnnouncementBanner")

@if (Model.AccountStatus == "UNVERIFIED")
{
    <div class="banner warn" role="status">
        <div class="banner-b">
            <strong>Your account is pending verification</strong>
            <span>An administrator is reviewing your registration. You can browse equipment, but reservations unlock once your account is verified.</span>
            <span><a href="/Support/Create?category=VERIFICATION">Ask about your verification</a></span>
        </div>
    </div>
}
else if (Model.AccountStatus == "REJECTED")
{
    <div class="banner err" role="alert">
        <div class="banner-b">
            <strong>Your account verification was rejected</strong>
            <span>Reason: @(string.IsNullOrWhiteSpace(Model.VerificationNote) ? "No reason was recorded." : Model.VerificationNote)</span>
            <span><a href="/Support/Create?category=APPEAL">Submit an appeal</a></span>
        </div>
    </div>
}

<div class="cp-hero">
    <div>
        <div class="cp-hero-title">@greeting, @Model.FirstName</div>
        <div class="cp-hero-sub">
            @if (Model.OverdueItems > 0)
            {
                <span>You have @Model.OverdueItems overdue item@(Model.OverdueItems == 1 ? "" : "s"). Returning overdue equipment unblocks new reservation requests.</span>
            }
            else if (Model.ActiveBorrowings > 0)
            {
                <span>You have @Model.ActiveBorrowings active borrowing@(Model.ActiveBorrowings == 1 ? "" : "s"). Check the due dates below to stay on schedule.</span>
            }
            else
            {
                <span>No equipment is currently borrowed. Browse the catalog to start a reservation.</span>
            }
        </div>
    </div>
    <div class="cp-hero-actions">
        <a href="/Reservations/Available" class="cp-btn cp-btn-light">Browse Equipment</a>
    </div>
</div>

<div class="cp-section-title">At a glance</div>
<div class="cp-kpi-grid">
    <a class="cp-kpi" href="/Borrowings/Mine">
        <div class="cp-kpi-label">Active Borrowings</div>
        <div class="cp-kpi-value">@Model.ActiveBorrowings</div>
    </a>
    <a class="cp-kpi" href="/Reservations/Mine">
        <div class="cp-kpi-label">Pending Reservations</div>
        <div class="cp-kpi-value @(Model.PendingReservations > 0 ? "warn" : "muted")">@Model.PendingReservations</div>
    </a>
    <a class="cp-kpi" href="/Reservations/Mine">
        <div class="cp-kpi-label">Approved / Ready for Pickup</div>
        <div class="cp-kpi-value">@Model.ApprovedReady</div>
    </a>
    <a class="cp-kpi" href="/Borrowings/Mine">
        <div class="cp-kpi-label">Overdue Items</div>
        <div class="cp-kpi-value @(Model.OverdueItems > 0 ? "error" : "muted")">@Model.OverdueItems</div>
    </a>
    <a class="cp-kpi" href="/Borrowings/History">
        <div class="cp-kpi-label">Completed This Term</div>
        <div class="cp-kpi-value">@Model.CompletedBorrowings</div>
    </a>
</div>

<div class="cp-stack">
    <div class="cp-grid-2">
        <div class="cp-card cp-card-flush">
            <div class="cp-card-header">
                Active Borrowings
                <a href="/Borrowings/Mine">View all</a>
            </div>
            <div class="cp-table-wrap">
                <table class="cp-table">
                    <thead>
                        <tr><th>Equipment</th><th>Transaction</th><th>Qty</th><th>Released</th><th>Due</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                        @if (!Model.ActiveBorrowingRows.Any())
                        {
                            <tr><td colspan="7"><div class="cp-empty-state compact"><div class="cp-empty-state-text">You have no active borrowings.</div></div></td></tr>
                        }
                        @foreach (var b in Model.ActiveBorrowingRows.Take(3))
                        {
                            var dueToday = b.IsDueToday && !b.IsOverdue;
                            <tr>
                                <td>
                                    <div class="cp-cell-name">@b.EquipmentName</div>
                                    <div class="cp-cell-sub">@b.AssetCode</div>
                                </td>
                                <td class="cp-mono">@b.TransactionNumber</td>
                                <td>@b.Quantity</td>
                                <td>@b.ReleasedAtUtc.ToLocalTime().ToString("dd MMM yyyy")<div class="cp-cell-sub">@b.ReleasedAtUtc.ToLocalTime().ToString("hh:mm tt")</div></td>
                                <td>@b.DueAtUtc.ToLocalTime().ToString("dd MMM yyyy")<div class="cp-cell-sub">@b.DueAtUtc.ToLocalTime().ToString("hh:mm tt")</div></td>
                                <td><span class="@StatusBadge.Css(dueToday ? "DUE_TODAY" : b.StatusCode)">@(dueToday ? "Due Today" : b.StatusDescription)</span></td>
                                <td><a class="cp-btn cp-btn-secondary cp-btn-sm" href="/Borrowings/Details/@b.BorrowingId">View</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="cp-card">
            <div class="cp-card-header">Upcoming Due Dates</div>
            <div class="cp-list">
                @if (!Model.UpcomingDue.Any())
                {
                    <div class="cp-empty-state compact"><div class="cp-empty-state-text">No upcoming due dates.</div></div>
                }
                @foreach (var due in Model.UpcomingDue)
                {
                    var dueToday = due.IsDueToday && !due.IsOverdue;
                    <div class="cp-list-row">
                        <div class="cp-list-main">
                            <div class="cp-list-title">@due.EquipmentName</div>
                            <div class="cp-list-sub">
                                @if (due.IsOverdue) { <text>@due.DaysOverdue day@(due.DaysOverdue == 1 ? "" : "s") overdue - return immediately</text> }
                                else if (due.IsDueToday) { <text>Due today - @due.DueAtUtc.ToLocalTime().ToString("hh:mm tt")</text> }
                                else { <text>Due @due.DueAtUtc.ToLocalTime().ToString("dd MMM, hh:mm tt")</text> }
                            </div>
                        </div>
                        <span class="@StatusBadge.Css(dueToday ? "DUE_TODAY" : due.StatusCode)">@(dueToday ? "Due Today" : due.StatusDescription)</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="cp-card cp-card-flush">
        <div class="cp-card-header">
            Recent Reservations
            <a href="/Reservations/Mine">View all</a>
        </div>
        <div class="cp-table-wrap">
            <table class="cp-table">
                <thead>
                    <tr><th>Request</th><th>Equipment</th><th>Requested Schedule</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @if (!Model.RecentReservations.Any())
                    {
                        <tr><td colspan="5"><div class="cp-empty-state compact"><div class="cp-empty-state-text">You have no reservation requests yet.</div></div></td></tr>
                    }
                    @foreach (var r in Model.RecentReservations.Take(3))
                    {
                        <tr>
                            <td class="cp-mono">@r.ReservationNumber</td>
                            <td>
                                <div class="cp-cell-name">@r.EquipmentName</div>
                                <div class="cp-cell-sub">@r.AssetCode &middot; Qty @r.Quantity</div>
                            </td>
                            <td>@r.RequestedStartAtUtc.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")<div class="cp-cell-sub">Return @r.ExpectedReturnAtUtc.ToLocalTime().ToString("dd MMM, hh:mm tt")</div></td>
                            <td><span class="@StatusBadge.Css(r.StatusCode)">@r.StatusDescription</span></td>
                            <td><a class="cp-btn cp-btn-secondary cp-btn-sm" href="/Reservations/Details/@r.ReservationId">View</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
