@using ASI.Basecode.Services.ViewModelClasses
@model CustodianWorkloadViewModel

<div class="cp-section-title">Custodian workload</div>
<div class="cp-grid-2">
    <div class="cp-card cp-card-flush">
        <div class="cp-card-header">
            <span>Open work by custodian</span>
            <a asp-controller="CustodianAssignments" asp-action="Index">Assignments</a>
        </div>
        <div class="cp-table-wrap">
            <table class="cp-table">
                <thead><tr><th>Custodian</th><th class="text-center">Pending</th><th class="text-center">Approved</th><th class="text-center">Rules</th></tr></thead>
                <tbody>
                    @foreach (var w in Model.Rows)
                    {
                        <tr>
                            <td><a asp-controller="Users" asp-action="Details" asp-route-id="@w.CustodianUserId" class="name-link">@w.CustodianName</a></td>
                            <td class="text-center cp-mono">@w.Pending</td>
                            <td class="text-center cp-mono">@w.Approved</td>
                            <td class="text-center cp-mono">@w.AssignmentCount</td>
                        </tr>
                    }
                    <tr>
                        <td><span class="cp-badge cp-badge-neutral">Shared pool</span></td>
                        <td class="text-center cp-mono">@Model.PoolPending</td>
                        <td class="text-center cp-mono">@Model.PoolApproved</td>
                        <td class="text-center">—</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="cp-card cp-card-flush">
        <div class="cp-card-header">Reassign open reservations</div>
        @if (Model.OpenReservations.Count == 0)
        {
            <div class="cp-empty-state compact"><div class="cp-empty-state-text">No open reservations.</div></div>
        }
        else
        {
            <div class="cp-table-wrap">
                <table class="cp-table">
                    <thead><tr><th>Reservation</th><th>Custodian</th></tr></thead>
                    <tbody>
                        @foreach (var r in Model.OpenReservations)
                        {
                            <tr>
                                <td>
                                    <span class="cp-cell-name cp-mono">@r.ReservationNumber</span>
                                    <div class="cp-cell-sub">@r.BorrowerName &middot; @r.EquipmentName &middot; @r.StatusDescription</div>
                                </td>
                                <td>
                                    <form method="post" asp-controller="CustodianAssignments" asp-action="Reassign" style="display:flex;gap:6px;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="reservationId" value="@r.ReservationId" />
                                        <select name="custodianUserId" class="cp-select" aria-label="Custodian for @r.ReservationNumber">
                                            <option value="" selected="@(r.AssignedCustodianUserId == null)">Shared pool</option>
                                            @foreach (var c in Model.CustodianOptions)
                                            {
                                                <option value="@c.Id" selected="@(r.AssignedCustodianUserId == c.Id)">@c.Text</option>
                                            }
                                        </select>
                                        <button type="submit" class="cp-btn cp-btn-secondary cp-btn-sm">Save</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
