@using ASI.Basecode.Services.ViewModelClasses
@model AuditLogsViewModel
@{
    ViewData["Title"] = "Audit Logs";
}

<div class="cp-page-header">
    <div>
        <h1 class="cp-page-title">Audit Logs</h1>
        <p class="cp-page-subtitle">System activity trail.</p>
    </div>
    <div class="cp-page-actions">
        <a asp-action="ExportAuditCsv" asp-route-search="@Model.Search" asp-route-entityType="@Model.EntityType" class="cp-btn cp-btn-secondary cp-btn-sm">Export CSV</a>
    </div>
</div>

<div class="cp-filter-bar">
    <form method="get" asp-action="AuditLogs" style="display:contents">
        <input type="text" name="search" value="@Model.Search" class="cp-input" placeholder="Search details, reference, action..." />
        <select name="entityType" class="cp-select">
            @foreach (var et in Model.EntityTypes)
            {
                <option value="@et" selected="@(Model.EntityType == et)">@et</option>
            }
        </select>
        <button type="submit" class="cp-btn cp-btn-secondary cp-btn-sm">Apply</button>
        <a asp-action="AuditLogs" class="cp-btn cp-btn-secondary cp-btn-sm">Clear</a>
    </form>
</div>

@if (!Model.Page.Items.Any())
{
    <div class="cp-empty-state compact"><div class="cp-empty-state-text">No audit entries found.</div></div>
}
else
{
    <div class="cp-table-wrap">
        <table class="cp-table">
            <thead>
                <tr>
                    <th>When</th>
                    <th>Actor</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Reference</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Page.Items)
                {
                    <tr>
                        <td class="cp-mono">@a.OccurredAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td>@a.ActorName</td>
                        <td>@a.ActionType</td>
                        <td>@a.EntityType</td>
                        <td class="cp-mono">@(a.ReferenceNumber ?? "—")</td>
                        <td>@(a.Details ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@await Html.PartialAsync("_Pagination", ASI.Basecode.WebApp.Models.PaginationModel.From(Model.Page))