@model DashboardViewModel
@{
    ViewData["Title"] = "Tracking & Reports";
}

<div class="cp-page-header">
    <div>
        <h1 class="cp-page-title">Tracking &amp; Reports</h1>
        <p class="cp-page-subtitle">Reservation totals and exportable records. Live utilisation and inventory figures are on the <a href="/Monitoring/Dashboard">admin dashboard</a>.</p>
    </div>
</div>

<div class="cp-grid-2">
    <div class="cp-card">
        <div class="cp-card-header">Reservation Summary <span class="cp-cell-sub">All reservation statuses</span></div>
        <dl class="cp-kv">
            <dt>Total reservations</dt><dd>@Model.ReservationTotal</dd>
            <dt>Pending</dt><dd>@Model.ReservationPending</dd>
            <dt>Approved</dt><dd>@Model.ReservationApproved</dd>
            <dt>Ready for release</dt><dd>@Model.ReservationReadyForRelease</dd>
            <dt>Completed</dt><dd>@Model.ReservationCompleted</dd>
            <dt>Rejected</dt><dd>@Model.ReservationRejected</dd>
            <dt>Cancelled</dt><dd>@Model.ReservationCancelled</dd>
        </dl>
    </div>

    <div class="cp-card">
        <div class="cp-card-header">Export Reports <span class="cp-cell-sub">CSV files for external reporting</span></div>
        <div class="cp-stack">
            <a href="/Monitoring/ExportAuditCsv" class="cp-btn cp-btn-secondary">Export Audit Logs (CSV)</a>
            <a href="/Monitoring/ExportReservationsCsv" class="cp-btn cp-btn-secondary">Export Reservations (CSV)</a>
            <a href="/Monitoring/ExportBorrowingsCsv" class="cp-btn cp-btn-secondary">Export Borrowings (CSV)</a>
            <a href="/Monitoring/ExportMovementsCsv" class="cp-btn cp-btn-secondary">Export Inventory Movements (CSV)</a>
        </div>
    </div>
</div>
