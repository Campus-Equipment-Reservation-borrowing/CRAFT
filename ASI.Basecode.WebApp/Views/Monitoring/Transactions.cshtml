@using ASI.Basecode.Services.ViewModelClasses
@model TransactionMonitoringViewModel
@{
    ViewData["Title"] = "Transaction Monitoring";
}

<div class="cp-page-header">
    <div>
        <h1 class="cp-page-title">Transaction Monitoring</h1>
        <p class="cp-page-subtitle">All reservations and borrowings in one view.</p>
    </div>
</div>

<div class="cp-filter-bar">
    <form method="get" asp-action="Transactions" style="display:contents">
        <input type="text" name="search" value="@Model.Search" class="cp-input" placeholder="Search by reference, actor, equipment..." />
        <select name="tab" class="cp-select">
            <option value="All" selected="@(Model.Tab == "All")">All transactions</option>
            <option value="Reservations" selected="@(Model.Tab == "Reservations")">Reservations only</option>
            <option value="Borrowings" selected="@(Model.Tab == "Borrowings")">Borrowings only</option>
        </select>
        <button type="submit" class="cp-btn cp-btn-secondary cp-btn-sm">Apply</button>
        <a asp-action="Transactions" class="cp-btn cp-btn-secondary cp-btn-sm">Clear</a>
    </form>
</div>

@if (!Model.Page.Items.Any())
{
    <div class="cp-empty-state compact"><div class="cp-empty-state-text">No transactions found.</div></div>
}
else
{
    <div class="cp-table-wrap">
        <table class="cp-table">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Reference</th>
                    <th>Date</th>
                    <th>Actor</th>
                    <th>Equipment</th>
                    <th>Qty</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Page.Items)
                {
                    <tr>
                        <td><span class="cp-badge @(t.Type == "Reservation" ? "cp-badge-info" : "cp-badge-success")">@t.Type</span></td>
                        <td><span class="cp-mono">@t.Reference</span></td>
                        <td class="cp-mono">@t.Date.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td>@t.Actor</td>
                        <td>
                            <span class="cp-cell-name">@t.Equipment</span>
                            <div class="cp-cell-sub cp-mono">@t.AssetCode</div>
                        </td>
                        <td class="cp-mono">@t.Quantity</td>
                        <td><span class="@StatusBadge.Css(t.StatusCode)">@t.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@await Html.PartialAsync("_Pagination", ASI.Basecode.WebApp.Models.PaginationModel.From(Model.Page))