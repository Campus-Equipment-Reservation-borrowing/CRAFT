@model DashboardViewModel
@{
    ViewData["Title"] = "Administrator Dashboard";
}

<div class="cp-page-header">
    <div>
        <h1 class="cp-page-title">Administrator Dashboard</h1>
        <p class="cp-page-subtitle">System-wide totals for users, equipment and transactions.</p>
    </div>
</div>

<div class="cp-hero">
    <div>
        <div class="cp-hero-title">CRAFT overview</div>
        <div class="cp-hero-sub">
            Each tile below opens the list behind it: users, equipment, transactions or the audit log.
        </div>
    </div>
</div>

@await Component.InvokeAsync("AnnouncementBanner")

<div class="cp-section-title">At a glance</div>
<div class="cp-kpi-grid">
    <a class="cp-kpi" href="/Users">
        <div class="cp-kpi-label">Total Users</div>
        <div class="cp-kpi-value">@Model.TotalUsers</div>
    </a>
    <a class="cp-kpi" href="/Equipment">
        <div class="cp-kpi-label">Equipment Records</div>
        <div class="cp-kpi-value">@Model.EquipmentRecords</div>
    </a>
    <a class="cp-kpi" href="/Equipment">
        <div class="cp-kpi-label">Available Units</div>
        <div class="cp-kpi-value">@Model.AvailableUnits</div>
    </a>
    <a class="cp-kpi" href="/Monitoring/Transactions">
        <div class="cp-kpi-label">Reserved Units</div>
        <div class="cp-kpi-value muted">@Model.ReservedUnits</div>
    </a>
    <a class="cp-kpi" href="/Monitoring/Transactions">
        <div class="cp-kpi-label">Borrowed Units</div>
        <div class="cp-kpi-value muted">@Model.BorrowedUnits</div>
    </a>
    <a class="cp-kpi" href="/Monitoring/Transactions">
        <div class="cp-kpi-label">Overdue Transactions</div>
        <div class="cp-kpi-value @(Model.BorrowingOverdue > 0 ? "error" : "muted")">@Model.BorrowingOverdue</div>
    </a>
    <a class="cp-kpi" href="/Monitoring/AuditLogs">
        <div class="cp-kpi-label">Damaged / Lost</div>
        <div class="cp-kpi-value @(Model.DamagedLostUnits > 0 ? "warn" : "muted")">@Model.DamagedLostUnits</div>
    </a>
</div>

<div class="cp-section-title">Reservation statistics</div>
<div class="cp-kpi-grid">
    <a class="cp-kpi" href="/Monitoring/Transactions">
        <div class="cp-kpi-label">Total</div>
        <div class="cp-kpi-value">@Model.ReservationTotal</div>
    </a>
    <a class="cp-kpi" href="/Monitoring/Transactions">
        <div class="cp-kpi-label">Pending</div>
        <div class="cp-kpi-value warn">@Model.ReservationPending</div>
    </a>
    <a class="cp-kpi" href="/Monitoring/Transactions">
        <div class="cp-kpi-label">Approved</div>
        <div class="cp-kpi-value">@Model.ReservationApproved</div>
    </a>
    <a class="cp-kpi" href="/Monitoring/Transactions">
        <div class="cp-kpi-label">Ready for Release</div>
        <div class="cp-kpi-value">@Model.ReservationReadyForRelease</div>
    </a>
    <a class="cp-kpi" href="/Monitoring/Transactions">
        <div class="cp-kpi-label">Completed</div>
        <div class="cp-kpi-value muted">@Model.ReservationCompleted</div>
    </a>
    <a class="cp-kpi" href="/Monitoring/Transactions">
        <div class="cp-kpi-label">Rejected</div>
        <div class="cp-kpi-value error">@Model.ReservationRejected</div>
    </a>
    <a class="cp-kpi" href="/Monitoring/Transactions">
        <div class="cp-kpi-label">Cancelled</div>
        <div class="cp-kpi-value muted">@Model.ReservationCancelled</div>
    </a>
</div>

@if (ViewBag.VerificationStats is ASI.Basecode.Services.ViewModelClasses.VerificationStatsViewModel verificationStats)
{
    <partial name="_VerificationStats" model="verificationStats" />
}

@if (ViewBag.Workload is ASI.Basecode.Services.ViewModelClasses.CustodianWorkloadViewModel workload)
{
    <partial name="_CustodianWorkload" model="workload" />
}

<div class="cp-section-title">Recent system activity</div>
<div class="cp-card cp-card-flush">
    <div class="cp-card-header">
        <span>Latest recorded actions</span>
        <a href="/Monitoring/AuditLogs">View all</a>
    </div>
    <div class="cp-table-wrap">
        <table class="cp-table">
            <thead>
                <tr>
                    <th>When</th>
                    <th>Actor</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Reference</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.RecentAudit.Any())
                {
                    <tr><td colspan="6"><div class="cp-empty-state compact"><div class="cp-empty-state-text">No activity yet.</div></div></td></tr>
                }
                @foreach (var a in Model.RecentAudit)
                {
                    <tr>
                        <td>@a.OccurredAtUtc.ToLocalTime().ToString("dd MMM HH:mm")</td>
                        <td>@a.ActorName</td>
                        <td>@a.ActionType</td>
                        <td>@a.EntityType</td>
                        <td class="cp-mono">@(a.ReferenceNumber ?? "-")</td>
                        <td>@(a.Details ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
