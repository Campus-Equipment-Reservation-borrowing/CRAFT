@using ASI.Basecode.Services.ViewModelClasses
@model EquipmentFormViewModel
@{
    ViewData["Title"] = "Edit Equipment";
}

<div class="cp-page-header">
    <div>
        <partial name="_Breadcrumb" model='new[] { ("Equipment", "/Equipment") }' />
        <h1 class="cp-page-title">Edit Equipment</h1>
        <p class="cp-page-subtitle">Update record details and photo. Deleting a record is blocked while borrowings reference it.</p>
    </div>
</div>

<div class="cp-card cp-card-narrow">
    <form asp-action="Edit" asp-route-id="@Model.EquipmentId" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <partial name="_EquipmentForm" model="Model" />
    </form>
</div>
