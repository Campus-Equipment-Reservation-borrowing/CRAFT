@using ASI.Basecode.Services.ViewModelClasses
@model EquipmentFormViewModel
@{
    ViewData["Title"] = "Add Equipment";
}

<div class="cp-page-header">
    <div>
        <partial name="_Breadcrumb" model='new[] { ("Equipment", "/Equipment") }' />
        <h1 class="cp-page-title">Add Equipment</h1>
        <p class="cp-page-subtitle">Fields marked with an asterisk are required.</p>
    </div>
</div>

<div class="cp-card cp-card-narrow">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <partial name="_EquipmentForm" model="Model" />
    </form>
</div>
