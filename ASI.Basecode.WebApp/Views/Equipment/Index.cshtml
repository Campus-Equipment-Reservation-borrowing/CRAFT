@using ASI.Basecode.Services.ViewModelClasses
@using Microsoft.AspNetCore.Mvc.Rendering
@model EquipmentIndexViewModel
@{
    ViewData["Title"] = "Equipment Management";
}

<div class="cp-page-header">
    <div>
        <h1 class="cp-page-title">Equipment Management</h1>
        <p class="cp-page-subtitle">System-wide equipment records, categories, locations and maintenance information.</p>
    </div>
    <div class="cp-page-actions">
        <a asp-action="Create" class="cp-btn cp-btn-primary">Add Equipment</a>
    </div>
</div>

<div class="cp-kpi-grid">
    <div class="cp-kpi">
        <div class="cp-kpi-label">Equipment Records</div>
        <div class="cp-kpi-value">@(Model.Totals?.RecordCount ?? 0)</div>
    </div>
    <div class="cp-kpi">
        <div class="cp-kpi-label">Total Units</div>
        <div class="cp-kpi-value">@(Model.Totals?.TotalUnits ?? 0)</div>
    </div>
    <div class="cp-kpi">
        <div class="cp-kpi-label">Available</div>
        <div class="cp-kpi-value">@(Model.Totals?.AvailableUnits ?? 0)</div>
    </div>
    <div class="cp-kpi">
        <div class="cp-kpi-label">Reserved</div>
        <div class="cp-kpi-value warn">@(Model.Totals?.ReservedUnits ?? 0)</div>
    </div>
    <div class="cp-kpi">
        <div class="cp-kpi-label">Released</div>
        <div class="cp-kpi-value muted">@(Model.Totals?.ReleasedUnits ?? 0)</div>
    </div>
</div>

<div class="cp-filter-bar">
    <form method="get" asp-action="Index" class="cp-contents">
        <input type="text" name="search" aria-label="Search" maxlength="100" value="@Model.Search" class="cp-input" placeholder="Search by asset code, name or category..." />
        <select name="category" aria-label="Filter by category" class="cp-select" asp-items="@(ViewBag.CategoryOptions as SelectList)"></select>
        <select name="location" aria-label="Filter by location" class="cp-select" asp-items="@(ViewBag.LocationOptions as SelectList)"></select>
        <select name="condition" aria-label="Filter by condition" class="cp-select" asp-items="@(ViewBag.ConditionOptions as SelectList)"></select>
        <select name="operationalStatus" aria-label="Filter by operational status" class="cp-select" asp-items="@(ViewBag.OperationalStatusOptions as SelectList)"></select>
        <button type="submit" class="cp-btn cp-btn-secondary cp-btn-sm">Apply</button>
        <a asp-action="Index" class="cp-btn cp-btn-secondary cp-btn-sm">Clear</a>
    </form>
</div>

<div class="cp-card cp-card-flush">
    <div class="cp-table-wrap">
        <table class="cp-table">
            <thead>
                <tr>
                    <th>Equipment</th>
                    <th>Category / Location</th>
                    <th>Available / Total</th>
                    <th>Condition</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Page.Items.Any())
                {
                    <tr><td colspan="6"><div class="cp-empty-state compact"><div class="cp-empty-state-text">No equipment records found.</div></div></td></tr>
                }
                @foreach (var eq in Model.Page.Items)
                {
                    var statusCode = eq.OperationalStatusName?.Trim().ToUpperInvariant().Replace(' ', '_');
                    <tr class="@(eq.IsActive ? "" : "cp-muted-row")">
                        <td>
                            <div class="cp-cell-media">
                                @if (!string.IsNullOrWhiteSpace(eq.ImagePath))
                                {
                                    <img src="@eq.ImagePath" alt="" class="cp-avatar cp-avatar-sm" />
                                }
                                <div>
                                    <a asp-action="Details" asp-route-id="@eq.EquipmentId" class="cp-cell-name">@eq.EquipmentName</a>
                                    <div class="cp-cell-sub cp-mono">@eq.AssetCode</div>
                                </div>
                            </div>
                        </td>
                        <td>@eq.CategoryName<div class="cp-cell-sub">@(eq.LocationName ?? "No location")</div></td>
                        <td><span class="cp-mono">@eq.AvailableUnits / @eq.TotalQuantity</span></td>
                        <td>@(eq.ConditionName ?? "-")</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(eq.OperationalStatusName))
                            {
                                <span class="@StatusBadge.Css(statusCode)">@eq.OperationalStatusName</span>
                            }
                            @if (!eq.IsActive)
                            {
                                <span class="cp-badge cp-badge-neutral">Inactive</span>
                            }
                        </td>
                        <td class="cp-cell-actions">
                            <a asp-action="Edit" asp-route-id="@eq.EquipmentId" class="cp-btn cp-btn-secondary cp-btn-sm">Edit</a>
                            <form method="post" asp-action="Delete" asp-route-id="@eq.EquipmentId" data-confirm="Delete @eq.EquipmentName? This can't be undone." onsubmit="return confirm(this.dataset.confirm);">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="cp-btn cp-btn-danger cp-btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.Page != null && Model.Page.TotalPages > 1)
{
    <div class="cp-pagination">
        <span class="cp-pagination-info">Page @Model.Page.Page of @Model.Page.TotalPages (@Model.Page.TotalCount records)</span>
        <ul class="cp-pagination-list">
            <li class="@(Model.Page.HasPrevious ? "" : "disabled")">
                <a asp-action="Index" asp-route-search="@Model.Search" asp-route-category="@Model.CategoryId" asp-route-location="@Model.LocationId" asp-route-condition="@Model.ConditionId" asp-route-operationalStatus="@Model.OperationalStatusId" asp-route-page="@(Model.Page.Page - 1)">‹</a>
            </li>
            @for (var p = 1; p <= Model.Page.TotalPages; p++)
            {
                <li class="@(p == Model.Page.Page ? "active" : "")">
                    <a asp-action="Index" asp-route-search="@Model.Search" asp-route-category="@Model.CategoryId" asp-route-location="@Model.LocationId" asp-route-condition="@Model.ConditionId" asp-route-operationalStatus="@Model.OperationalStatusId" asp-route-page="@p">@p</a>
                </li>
            }
            <li class="@(Model.Page.HasNext ? "" : "disabled")">
                <a asp-action="Index" asp-route-search="@Model.Search" asp-route-category="@Model.CategoryId" asp-route-location="@Model.LocationId" asp-route-condition="@Model.ConditionId" asp-route-operationalStatus="@Model.OperationalStatusId" asp-route-page="@(Model.Page.Page + 1)">›</a>
            </li>
        </ul>
    </div>
}
