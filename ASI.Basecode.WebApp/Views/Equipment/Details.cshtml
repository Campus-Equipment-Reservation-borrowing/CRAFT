@using ASI.Basecode.Data.Models
@model Equipment
@{
    ViewData["Title"] = Model.EquipmentName;
    var balance = Model.EquipmentInventoryBalance;
    var available = balance == null
        ? 0
        : Math.Max(0, balance.TotalQuantity - balance.ReservedQuantity - balance.ReleasedQuantity
            - balance.AwaitingInspectionQuantity - balance.MaintenanceQuantity - balance.UnreconciledQuantity);
}

<div class="cp-page-header">
    <div>
        <partial name="_Breadcrumb" model='new[] { ("Equipment", "/Equipment") }' />
        <h1 class="cp-page-title">@Model.EquipmentName</h1>
        <p class="cp-page-subtitle">Equipment record, condition and inventory balance.</p>
    </div>
    <div class="cp-page-actions">
        <a asp-action="Label" asp-route-id="@Model.EquipmentId" class="cp-btn cp-btn-secondary">Print QR label</a>
        <a asp-action="Edit" asp-route-id="@Model.EquipmentId" class="cp-btn cp-btn-primary">Edit</a>
    </div>
</div>

<div class="cp-grid-2">
    <div class="cp-card">
        @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
        {
            <img src="@Model.ImagePath" alt="@Model.EquipmentName" style="display:block;width:100%;max-height:260px;object-fit:cover;border-radius:10px;margin-bottom:14px" />
        }
        <dl class="cp-kv">
            <dt>Asset Code</dt><dd><span class="cp-mono">@Model.AssetCode</span></dd>
            <dt>Category</dt><dd>@(Model.EquipmentCategory?.CategoryName ?? "-")</dd>
            <dt>Location</dt><dd>@(Model.Location?.LocationName ?? "-")</dd>
            <dt>Condition</dt><dd>@(Model.CurrentCondition?.Description ?? "-")</dd>
            <dt>Status</dt>
            <dd>
                @if (Model.OperationalStatus != null)
                {
                    <span class="@StatusBadge.Css(Model.OperationalStatus.Code)">@Model.OperationalStatus.Description</span>
                }
                else
                {
                    <span>-</span>
                }
                @if (!Model.IsActive)
                {
                    <span class="cp-badge cp-badge-neutral">Inactive</span>
                }
            </dd>
            <dt>Created</dt><dd>@Model.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</dd>
            <dt>Description</dt><dd>@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</dd>
        </dl>
    </div>

    <div class="cp-card">
        <div class="cp-card-header">Inventory Balance</div>
        @if (balance == null)
        {
            <div class="cp-empty-state compact"><div class="cp-empty-state-text">No inventory balance is recorded for this equipment yet.</div></div>
        }
        else
        {
            <dl class="cp-kv">
                <dt>Available</dt><dd>@available</dd>
                <dt>Total Quantity</dt><dd>@balance.TotalQuantity</dd>
                <dt>Reserved</dt><dd>@balance.ReservedQuantity</dd>
                <dt>Released</dt><dd>@balance.ReleasedQuantity</dd>
            </dl>
        }
    </div>
</div>
