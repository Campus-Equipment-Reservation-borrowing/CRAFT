@using ASI.Basecode.Services.ViewModelClasses
@using Microsoft.AspNetCore.Mvc.Rendering
@model EquipmentFormViewModel

@if (ViewData.ModelState.TryGetValue(string.Empty, out var modelEntry) && modelEntry.Errors.Count > 0)
{
    <div asp-validation-summary="ModelOnly" class="cp-validation-summary"></div>
}
<input type="hidden" asp-for="EquipmentId" />
<input type="hidden" asp-for="ImagePath" />

<div class="cp-grid-2">
    <div class="cp-form-group">
        <label class="cp-form-label" asp-for="EquipmentName">Equipment Name <span class="required">*</span></label>
        <input asp-for="EquipmentName" class="cp-input" placeholder="e.g. Dell Latitude 5440 Laptop" />
        <span asp-validation-for="EquipmentName" class="cp-form-error"></span>
    </div>
    <div class="cp-form-group">
        <label class="cp-form-label" asp-for="AssetCode">Asset Code <span class="required">*</span></label>
        <input asp-for="AssetCode" class="cp-input" placeholder="e.g. LPT-2024-018" />
        <div class="cp-form-hint">Must be unique across the system.</div>
        <span asp-validation-for="AssetCode" class="cp-form-error"></span>
    </div>
</div>

<div class="cp-grid-2">
    <div class="cp-form-group">
        <label class="cp-form-label" asp-for="EquipmentCategoryId">Category <span class="required">*</span></label>
        <select asp-for="EquipmentCategoryId" class="cp-select" asp-items="@(ViewBag.CategoryOptions as SelectList)"></select>
        <span asp-validation-for="EquipmentCategoryId" class="cp-form-error"></span>
    @if (User.IsInRole(ASI.Basecode.Resources.Constants.RoleCodes.Admin))
    {
        <div class="cp-form-hint">Missing a category? <a href="/Settings#categories">Add one in System Settings</a>.</div>
    }
    </div>
    <div class="cp-form-group">
        <label class="cp-form-label" asp-for="LocationId">Location</label>
        <select asp-for="LocationId" class="cp-select" asp-items="@(ViewBag.LocationOptions as SelectList)"></select>
        <span asp-validation-for="LocationId" class="cp-form-error"></span>
    </div>
</div>

<div class="cp-grid-2">
    <div class="cp-form-group">
        <label class="cp-form-label" asp-for="OperationalStatusId">Availability Status <span class="required">*</span></label>
        <select asp-for="OperationalStatusId" class="cp-select" asp-items="@(ViewBag.OperationalStatusOptions as SelectList)"></select>
        <span asp-validation-for="OperationalStatusId" class="cp-form-error"></span>
    </div>
    <div class="cp-form-group">
        <label class="cp-form-label" asp-for="CurrentConditionId">Condition Classification <span class="required">*</span></label>
        <select asp-for="CurrentConditionId" class="cp-select" asp-items="@(ViewBag.ConditionOptions as SelectList)"></select>
        <span asp-validation-for="CurrentConditionId" class="cp-form-error"></span>
    </div>
</div>

<div class="cp-form-group">
    <label class="cp-form-label" asp-for="TotalQuantity">Total Quantity <span class="required">*</span></label>
    <input asp-for="TotalQuantity" type="number" min="1" max="10000" step="1" class="cp-input" />
    @if (Model.EquipmentId > 0)
    {
        <div class="cp-form-hint">The total cannot drop below units currently held by borrowers.</div>
    }
    <span asp-validation-for="TotalQuantity" class="cp-form-error"></span>
</div>

<div class="cp-form-group">
    <label class="cp-form-label" asp-for="Description">Description</label>
    <textarea asp-for="Description" class="cp-textarea" rows="3" placeholder="Configuration, accessories issued and usage notes..."></textarea>
    <span asp-validation-for="Description" class="cp-form-error"></span>
</div>

<div class="cp-form-group">
    <label class="cp-form-label" for="imageFile">Equipment Photo</label>
    @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
    {
        <img src="@Model.ImagePath" alt="@Model.EquipmentName" style="display:block;width:104px;height:104px;object-fit:cover;border-radius:12px;margin-bottom:8px" />
    }
    <input type="file" id="imageFile" name="imageFile" accept=".jpg,.jpeg,.png,.webp,.gif" class="cp-input" />
    <div class="cp-form-hint">JPG, PNG, WEBP or GIF, up to 5 MB.</div>
    @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
    {
        <label class="cp-form-hint">
            <input type="checkbox" name="removeImage" value="true" /> Remove current photo
        </label>
    }
</div>

<div class="cp-form-group">
    <label class="cp-form-hint">
        <input asp-for="IsActive" type="checkbox" /> Active (available for reservations)
    </label>
</div>

<div class="cp-row-between">
    <a asp-action="Index" class="cp-btn cp-btn-secondary">Cancel</a>
    <button type="submit" class="cp-btn cp-btn-primary">Save Equipment</button>
</div>
