@using ASI.Basecode.Services.ViewModelClasses
@model UserFormViewModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="cp-page-header">
    <div>
        <partial name="_Breadcrumb" model='new[] { ("Users", "/Users") }' />
        <h1 class="cp-page-title">Edit User</h1>
        <p class="cp-page-subtitle">Update the account details, role and status.</p>
    </div>
</div>

<div class="cp-card cp-card-narrow">
    <form asp-action="Edit" asp-route-id="@Model.UserId" method="post">
        @Html.AntiForgeryToken()
        <partial name="_UserForm" model="Model" />
    </form>
</div>
