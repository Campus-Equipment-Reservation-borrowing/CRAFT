@using ASI.Basecode.Services.ViewModelClasses
@model BorrowerHistoryViewModel
@{
    ViewData["Title"] = "Borrower History";
}

<div class="cp-page-header">
    <div>
        <partial name="_Breadcrumb" model='new[] { ("Users", "/Users"), (Model.BorrowerName, $"/Users/Details/{Model.UserId}") }' />
        <h1 class="cp-page-title">Borrower History</h1>
        <p class="cp-page-subtitle">Every reservation and borrowing made by this account.</p>
    </div>
</div>

<div class="cp-stack">
    @foreach (var (title, rows, numberLabel, startLabel, endLabel) in new[]
    {
        ("Reservations", Model.Reservations, "Reservation #", "Start", "Return by"),
        ("Borrowings", Model.Borrowings, "Transaction #", "Released", "Due"),
    })
    {
        <div class="cp-card cp-card-flush">
            <div class="cp-card-header">@title <span class="cp-cell-sub">@rows.Count</span></div>
            @if (rows.Count == 0)
            {
                <div class="cp-empty-state compact"><div class="cp-empty-state-text">No @title.ToLowerInvariant() yet.</div></div>
            }
            else
            {
                <div class="cp-table-wrap">
                    <table class="cp-table">
                        <thead><tr><th>@numberLabel</th><th>Equipment</th><th class="text-center">Qty</th><th>Status</th><th>@startLabel</th><th>@endLabel</th></tr></thead>
                        <tbody>
                            @foreach (var r in rows)
                            {
                                <tr>
                                    <td class="cp-mono">@r.Number</td>
                                    <td><div class="cp-cell-name">@r.EquipmentName</div><div class="cp-cell-sub cp-mono">@r.AssetCode</div></td>
                                    <td class="text-center cp-mono">@r.Quantity</td>
                                    <td>
                                        @r.Status
                                        @if (r.Late)
                                        {
                                            <span class="@StatusBadge.Css("OVERDUE")">Late</span>
                                        }
                                    </td>
                                    <td>@r.StartUtc.ToLocalTime().ToString("dd MMM yyyy")</td>
                                    <td>@r.EndUtc.ToLocalTime().ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>
