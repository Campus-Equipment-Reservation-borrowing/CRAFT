@using ASI.Basecode.Services.ViewModelClasses
@model UserIndexViewModel
@{
    ViewData["Title"] = "User Management";

    // Quick presets map onto the existing role/status filters by their seeded names.
    var roleItems = (ViewBag.RoleOptions as SelectList)?.ToList() ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var statusItems = (ViewBag.StatusOptions as SelectList)?.ToList() ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    string IdOf(List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> items, string text) =>
        items.FirstOrDefault(i => string.Equals(i.Text, text, StringComparison.OrdinalIgnoreCase))?.Value;
    var presets = new List<(string Label, string Role, string Status)>
    {
        ("All", null, null),
        ("Unverified", null, IdOf(statusItems, "Unverified")),
        ("Locked", null, IdOf(statusItems, "Locked")),
        ("Suspended", null, IdOf(statusItems, "Suspended")),
        ("Custodians", IdOf(roleItems, "Custodian"), null),
        ("Administrators", IdOf(roleItems, "Administrator"), null),
    };
    var currentRole = Model.RoleId?.ToString();
    var currentStatus = Model.AccountStatusId?.ToString();
    var presetFiltersOnly = string.IsNullOrWhiteSpace(Model.Search) && Model.DepartmentId == null;
}

<div class="cp-page-header">
    <div>
        <h1 class="cp-page-title">User Management</h1>
        <p class="cp-page-subtitle">Manage user accounts, roles, and departments.</p>
    </div>
    <div class="cp-page-actions">
        <a asp-action="Create" class="cp-btn cp-btn-success">Add User</a>
    </div>
</div>

<!-- KPI cards -->
<div class="cp-kpi-grid">
    <div class="cp-kpi">
        <div class="cp-kpi-label">Total Accounts</div>
        <div class="cp-kpi-value">@(Model.Totals?.TotalAccounts ?? 0)</div>
    </div>
    <div class="cp-kpi">
        <div class="cp-kpi-label">Students</div>
        <div class="cp-kpi-value">@(Model.Totals?.Students ?? 0)</div>
    </div>
    <div class="cp-kpi">
        <div class="cp-kpi-label">Faculty</div>
        <div class="cp-kpi-value">@(Model.Totals?.Faculty ?? 0)</div>
    </div>
    <div class="cp-kpi">
        <div class="cp-kpi-label">Custodians &amp; Admins</div>
        <div class="cp-kpi-value">@(Model.Totals?.CustodianAdmins ?? 0)</div>
    </div>
    <a class="cp-kpi" asp-action="Verifications" title="Open the verification queue">
        <div class="cp-kpi-label">Unverified</div>
        <div class="cp-kpi-value">@(Model.Totals?.Unverified ?? 0)</div>
    </a>
</div>

<!-- Quick presets -->
<div class="tabs" style="margin-bottom:12px">
    @foreach (var p in presets.Where(p => p.Label == "All" || p.Role != null || p.Status != null))
    {
        var on = presetFiltersOnly && p.Role == currentRole && p.Status == currentStatus;
        <a class="tab @(on ? "on" : "")" asp-action="Index" asp-route-role="@p.Role" asp-route-status="@p.Status">@p.Label</a>
    }
</div>

<!-- Filter bar -->
<div class="cp-filter-bar">
    <form method="get" asp-action="Index" style="display:contents;">
        <input type="text" name="search" value="@Model.Search" class="cp-input" placeholder="Search by name, account ID or email..." />
        <select name="role" class="cp-select" asp-items="@(ViewBag.RoleOptions as SelectList)"></select>
        <select name="department" class="cp-select" asp-items="@(ViewBag.DepartmentOptions as SelectList)"></select>
        <select name="status" class="cp-select" asp-items="@(ViewBag.StatusOptions as SelectList)"></select>
        <select name="pageSize" class="cp-select" aria-label="Rows per page">
            <option value="10" selected="@(Model.Page?.PageSize == 10)">10</option>
            <option value="25" selected="@(Model.Page?.PageSize == 25)">25</option>
        </select>
        <button type="submit" class="cp-btn cp-btn-secondary cp-btn-sm">Apply</button>
        <a asp-action="Index" class="cp-btn cp-btn-secondary cp-btn-sm">Clear</a>
    </form>
</div>

<!-- Table -->
@if (!Model.Page.Items.Any())
{
    <div class="cp-empty-state compact">
        <div class="cp-empty-state-text">No user accounts found.</div>
    </div>
}
else
{
    <div class="cp-table-wrap">
        <table class="cp-table">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Account ID</th>
                    <th>Role</th>
                    <th>Department</th>
                    <th>Contact</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Page.Items)
                {
                    <tr>
                        <td>
                            <div style="display:flex;align-items:center;gap:8px">
                                <div class="cp-avatar cp-avatar-sm">@(string.IsNullOrEmpty(u.FirstName) ? "" : u.FirstName.Substring(0,1))@(string.IsNullOrEmpty(u.LastName) ? "" : u.LastName.Substring(0,1))</div>
                                <a asp-action="Details" asp-route-id="@u.UserId" class="name-link cp-cell-name">@u.FirstName @u.LastName</a>
                            </div>
                        </td>
                        <td class="cp-mono">@u.AccountIdentifier</td>
                        <td>@u.RoleName</td>
                        <td>@(u.DepartmentName ?? "—")</td>
                        <td>@u.SchoolEmail</td>
                        <td>
                            <span class="@StatusBadge.AccountCss(u.AccountStatusCode)">@u.AccountStatusDescription</span>
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@u.UserId" class="cp-btn cp-btn-secondary cp-btn-sm">Edit</a>
                            <form method="post" asp-action="Delete" asp-route-id="@u.UserId" style="display:inline"
                                  onsubmit="return confirm('Delete this user account?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="cp-btn cp-btn-danger cp-btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@await Html.PartialAsync("_Pagination", ASI.Basecode.WebApp.Models.PaginationModel.From(Model.Page))