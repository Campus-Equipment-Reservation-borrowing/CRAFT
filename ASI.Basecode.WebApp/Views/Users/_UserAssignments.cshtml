@using ASI.Basecode.Services.ViewModelClasses
@model ASI.Basecode.Data.Models.User
@{
    var summary = ViewBag.AssignmentSummary as UserAssignmentSummaryViewModel;
}
@if (summary != null && summary.IsCustodian)
{
    <div class="cp-card cp-card-flush">
        <div class="cp-card-header">
            <span>Custodian Assignments</span>
            <a asp-controller="CustodianAssignments" asp-action="Index">Manage</a>
        </div>
        @if (summary.Assignments.Count == 0)
        {
            <div class="cp-empty-state compact"><div class="cp-empty-state-text">No borrowers, locations or categories assigned. This custodian only sees the shared pool.</div></div>
        }
        else
        {
            <div class="cp-table-wrap">
                <table class="cp-table">
                    <thead><tr><th>Covers</th><th>Type</th></tr></thead>
                    <tbody>
                        @foreach (var a in summary.Assignments)
                        {
                            <tr>
                                <td><span class="cp-cell-name">@a.TargetName</span><div class="cp-cell-sub">@a.TargetDetail</div></td>
                                <td><span class="cp-badge cp-badge-info">@(a.ScopeType switch { "BORROWER" => "Borrower", "LOCATION" => "Location", _ => "Category" })</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
else if (summary != null && summary.IsBorrower)
{
    <div class="cp-card">
        <div class="cp-card-header">
            <span>Assigned Custodian</span>
            <a asp-controller="CustodianAssignments" asp-action="Index">Manage</a>
        </div>
        @if (summary.AssignedCustodianName == null)
        {
            <p class="cp-cell-sub">Not assigned directly. Requests are routed by equipment location or category, or go to the shared pool.</p>
        }
        else
        {
            <p><a asp-action="Details" asp-route-id="@summary.AssignedCustodianUserId" class="name-link cp-cell-name">@summary.AssignedCustodianName</a> handles this borrower's reservations.</p>
        }
    </div>
}
