@using ASI.Basecode.Services.ViewModelClasses
@model VerificationQueueViewModel
@{
    ViewData["Title"] = "Pending Verifications";
    var isRejectedTab = Model.Tab == "rejected";
    var hasCustodians = Model.CustodianOptions != null && Model.CustodianOptions.Count > 0;
}

<div class="cp-page-header">
    <div>
        <h1 class="cp-page-title">Pending Verifications</h1>
        <p class="cp-page-subtitle">Review self-registered borrower accounts before they can reserve equipment.</p>
    </div>
</div>

<div class="tabs" role="tablist" style="margin-bottom:12px">
    <a class="tab @(isRejectedTab ? "" : "on")" role="tab" aria-selected="@(!isRejectedTab ? "true" : "false")"
       asp-action="Verifications" asp-route-tab="pending">Pending <span class="cp-badge cp-badge-warning">@Model.PendingCount</span></a>
    <a class="tab @(isRejectedTab ? "on" : "")" role="tab" aria-selected="@(isRejectedTab ? "true" : "false")"
       asp-action="Verifications" asp-route-tab="rejected">Rejected <span class="cp-badge cp-badge-neutral">@Model.RejectedCount</span></a>
</div>

@if (!hasCustodians)
{
    <div class="banner warn" id="noCustodians" style="margin-bottom:12px">
        <div class="banner-b">
            Approving an account requires assigning a custodian, and there are no active custodian accounts yet.
            <a asp-action="Create">Create a custodian account</a> first.
        </div>
    </div>
}

<div class="cp-filter-bar">
    <form method="get" asp-action="Verifications" style="display:contents">
        <input type="hidden" name="tab" value="@Model.Tab" />
        <input type="text" name="search" value="@Model.Search" class="cp-input" placeholder="Search by name, account ID or email..." aria-label="Search accounts" />
        <button type="submit" class="cp-btn cp-btn-secondary cp-btn-sm">Apply</button>
        <a asp-action="Verifications" asp-route-tab="@Model.Tab" class="cp-btn cp-btn-secondary cp-btn-sm">Clear</a>
    </form>
</div>

@if (Model.Page?.Items == null || !Model.Page.Items.Any())
{
    <div class="cp-empty-state compact">
        <div class="cp-empty-state-text">@(isRejectedTab ? "No rejected accounts." : "No accounts are waiting for verification.")</div>
    </div>
}
else
{
    <div class="cp-table-wrap">
        <table class="cp-table">
            <thead>
                <tr>
                    <th>Borrower</th>
                    <th>Account ID</th>
                    <th>Role</th>
                    <th>Department</th>
                    <th>Registered</th>
                    @if (isRejectedTab)
                    {
                        <th>Reason</th>
                    }
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Page.Items)
                {
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@u.UserId" class="name-link cp-cell-name">@u.FirstName @u.LastName</a>
                            <div class="cp-cell-sub">@u.SchoolEmail</div>
                        </td>
                        <td class="cp-mono">@u.AccountIdentifier</td>
                        <td>@u.RoleName</td>
                        <td>@(u.DepartmentName ?? "—")</td>
                        <td>@(u.CreatedAtUtc == default ? "—" : u.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy"))</td>
                        @if (isRejectedTab)
                        {
                            <td>@u.VerificationNote</td>
                        }
                        <td class="text-center">
                            <button type="button" class="cp-btn cp-btn-success cp-btn-sm js-approve"
                                    data-user-id="@u.UserId" data-user-name="@u.FirstName @u.LastName"
                                    data-current-custodian="@(Model.CurrentCustodianByUser.TryGetValue(u.UserId, out var cur) ? cur.ToString() : "")"
                                    disabled="@(!hasCustodians)"
                                    aria-describedby="@(hasCustodians ? null : "noCustodians")">Approve</button>
                            @if (!isRejectedTab)
                            {
                                <button type="button" class="cp-btn cp-btn-danger cp-btn-sm js-reject"
                                        data-user-id="@u.UserId" data-user-name="@u.FirstName @u.LastName">Reject</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.Page.TotalPages > 1)
    {
        <div class="cp-pagination">
            <span class="cp-pagination-info">Page @Model.Page.Page of @Model.Page.TotalPages (@Model.Page.TotalCount accounts)</span>
            <ul class="cp-pagination-list">
                <li class="@(Model.Page.HasPrevious ? "" : "disabled")"><a asp-action="Verifications" asp-route-tab="@Model.Tab" asp-route-search="@Model.Search" asp-route-page="@(Model.Page.Page - 1)">‹</a></li>
                @for (var p = 1; p <= Model.Page.TotalPages; p++)
                {
                    <li class="@(p == Model.Page.Page ? "active" : "")"><a asp-action="Verifications" asp-route-tab="@Model.Tab" asp-route-search="@Model.Search" asp-route-page="@p">@p</a></li>
                }
                <li class="@(Model.Page.HasNext ? "" : "disabled")"><a asp-action="Verifications" asp-route-tab="@Model.Tab" asp-route-search="@Model.Search" asp-route-page="@(Model.Page.Page + 1)">›</a></li>
            </ul>
        </div>
    }
}

<div class="cp-modal-overlay" id="approveModal" style="display:none;">
    <div class="cp-modal" role="dialog" aria-modal="true" aria-labelledby="approveTitle">
        <h2 class="cp-modal-title" id="approveTitle">Approve account</h2>
        <form method="post" id="approveForm" data-action-template="@Url.Action("Verify", new { id = "__ID__" })">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnTab" value="@Model.Tab" />
            <p class="cp-form-group"><strong id="approveName"></strong> will be able to reserve equipment. Their reservations are routed to the custodian you choose.</p>
            <div class="cp-form-group">
                <label class="cp-form-label" for="approveCustodian">Custodian <span class="required">*</span></label>
                <select id="approveCustodian" name="custodianUserId" class="cp-select" required>
                    <option value="">Select custodian…</option>
                    @foreach (var c in Model.CustodianOptions)
                    {
                        <option value="@c.Id">@c.Text</option>
                    }
                </select>
            </div>
            <div class="cp-page-actions">
                <button type="button" class="cp-btn cp-btn-secondary cp-btn-sm js-modal-cancel">Cancel</button>
                <button type="submit" class="cp-btn cp-btn-success cp-btn-sm">Approve and assign</button>
            </div>
        </form>
    </div>
</div>

<div class="cp-modal-overlay" id="rejectModal" style="display:none;">
    <div class="cp-modal" role="dialog" aria-modal="true" aria-labelledby="rejectTitle">
        <h2 class="cp-modal-title" id="rejectTitle">Reject verification</h2>
        <form method="post" id="rejectForm" data-action-template="@Url.Action("RejectVerification", new { id = "__ID__" })">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnTab" value="@Model.Tab" />
            <p class="cp-form-group">The borrower <strong id="rejectName"></strong> will be notified with this reason and can appeal.</p>
            <div class="cp-form-group">
                <label class="cp-form-label" for="rejectReason">Reason <span class="required">*</span></label>
                <textarea id="rejectReason" name="reason" class="cp-textarea" rows="3" maxlength="500" required
                          placeholder="e.g. Account ID does not match the registrar's records."></textarea>
            </div>
            <div class="cp-page-actions">
                <button type="button" class="cp-btn cp-btn-secondary cp-btn-sm js-modal-cancel">Cancel</button>
                <button type="submit" class="cp-btn cp-btn-danger cp-btn-sm">Reject account</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var openModal = null;
            var lastTrigger = null;

            function close() {
                if (!openModal) return;
                openModal.style.display = 'none';
                openModal = null;
                if (lastTrigger) lastTrigger.focus();
            }

            function open(modalId, btn, focusEl) {
                lastTrigger = btn;
                var modal = document.getElementById(modalId);
                var form = modal.querySelector('form');
                form.action = form.dataset.actionTemplate.replace('__ID__', encodeURIComponent(btn.dataset.userId));
                modal.style.display = 'flex';
                openModal = modal;
                focusEl.focus();
            }

            document.querySelectorAll('.js-approve').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    document.getElementById('approveName').textContent = btn.dataset.userName;
                    var select = document.getElementById('approveCustodian');
                    select.value = btn.dataset.currentCustodian || '';
                    open('approveModal', btn, select);
                });
            });

            document.querySelectorAll('.js-reject').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    document.getElementById('rejectName').textContent = btn.dataset.userName;
                    var reason = document.getElementById('rejectReason');
                    reason.value = '';
                    open('rejectModal', btn, reason);
                });
            });

            document.querySelectorAll('.js-modal-cancel').forEach(function (b) { b.addEventListener('click', close); });
            document.querySelectorAll('.cp-modal-overlay').forEach(function (m) {
                m.addEventListener('click', function (e) { if (e.target === m) close(); });
            });
            document.addEventListener('keydown', function (e) {
                if (!openModal) return;
                if (e.key === 'Escape') { close(); return; }
                if (e.key !== 'Tab') return;
                // Keep keyboard focus inside the open dialog.
                var items = openModal.querySelectorAll('button:not([disabled]), select, textarea, input:not([type=hidden])');
                if (!items.length) return;
                var first = items[0], last = items[items.length - 1];
                if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
                else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
            });
        })();
    </script>
}
