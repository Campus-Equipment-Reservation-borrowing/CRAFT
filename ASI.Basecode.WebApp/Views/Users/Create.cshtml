@using ASI.Basecode.Services.ViewModelClasses
@model UserFormViewModel
@{
    ViewData["Title"] = "Add User";
}

<div class="cp-page-header">
    <div>
        <partial name="_Breadcrumb" model='new[] { ("Users", "/Users") }' />
        <h1 class="cp-page-title">Add User</h1>
        <p class="cp-page-subtitle">Staff accounts get a temporary password they must change at first sign-in.</p>
    </div>
</div>

<div class="cp-card cp-card-narrow">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <partial name="_UserForm" model="Model" />
    </form>
</div>
