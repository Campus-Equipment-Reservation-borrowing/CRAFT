@using ASI.Basecode.Services.ViewModelClasses
@model SupportTicketFormViewModel
@{
    ViewData["Title"] = "New Support Ticket";
    var categories = new[]
    {
        ("VERIFICATION", "Account verification", "Questions about your pending registration."),
        ("APPEAL", "Appeal a decision", "Ask us to reconsider a rejected verification, reservation or penalty."),
        ("FEEDBACK", "Feedback", "Ideas and suggestions for the Property Office."),
        ("OTHER", "Something else", "Anything that doesn't fit above."),
    };
}

<div class="cp-page-header">
    <div>
        <partial name="_Breadcrumb" model='new[] { ("Support", "/Support") }' />
        <h1 class="cp-page-title">New Support Ticket</h1>
        <p class="cp-page-subtitle">An administrator will reply here; you'll get a notification when they do.</p>
    </div>
</div>

<div class="cp-card cp-card-narrow">
    <form method="post" asp-action="Create">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="cp-validation-summary"></div>

        <fieldset class="cp-form-group" style="border:0;padding:0">
            <legend class="cp-form-label">What is this about? <span class="required">*</span></legend>
            <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(200px, 1fr));gap:8px">
                @foreach (var (code, label, hint) in categories)
                {
                    <label class="cp-card" style="display:flex;gap:8px;align-items:flex-start;cursor:pointer">
                        <input type="radio" name="Category" value="@code" checked="@(Model.Category == code)" required />
                        <span><span class="cp-cell-name">@label</span><br /><span class="cp-cell-sub">@hint</span></span>
                    </label>
                }
            </div>
            <span asp-validation-for="Category" class="cp-form-error"></span>
        </fieldset>

        <div class="cp-form-group">
            <label class="cp-form-label" asp-for="Subject">Subject <span class="required">*</span></label>
            <input asp-for="Subject" class="cp-input" maxlength="200" required />
            <span asp-validation-for="Subject" class="cp-form-error"></span>
        </div>
        <div class="cp-form-group">
            <label class="cp-form-label" asp-for="Body">Message <span class="required">*</span></label>
            <textarea asp-for="Body" class="cp-textarea" rows="6" maxlength="4000" required></textarea>
            <span asp-validation-for="Body" class="cp-form-error"></span>
        </div>
        <div class="cp-page-actions">
            <a asp-action="Index" class="cp-btn cp-btn-secondary">Cancel</a>
            <button type="submit" class="cp-btn cp-btn-primary">Submit ticket</button>
        </div>
    </form>
</div>
