@{
    Layout = null;

    var routeValues = ViewContext.RouteData.Values;
    var controller = routeValues["controller"]?.ToString() ?? "";
    var action = routeValues["action"]?.ToString() ?? "";

    var isAccount = controller.Equals("Account", StringComparison.OrdinalIgnoreCase);
    var isRegisterPage = isAccount &&
        (action.Equals("Register", StringComparison.OrdinalIgnoreCase) ||
         action.Equals("CreateAccount", StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CRAFT: Campus Reservation and Asset Flow Tracker</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>
    <div class="cp-auth-page">
        <!-- Top bar -->
        <nav class="cp-auth-nav">
            <a href="/" class="cp-auth-brand">
                <div class="cp-logo">CR</div>
                <div>
                    <div class="cp-topbar-title">CRAFT</div>
                    <div class="cp-topbar-subtitle">Campus Reservation and Asset Flow Tracker</div>
                </div>
            </a>
            <div class="cp-auth-nav-links">
                <a href="/">Home</a>
                @if (isRegisterPage)
                {
                    <a href="/Account/Login">Log in</a>
                }
                else
                {
                    <a href="/Account/Register">Create account</a>
                }
            </div>
        </nav>

        <!-- Content -->
        <main class="cp-auth-main">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="cp-auth-footer">
            <div class="cp-auth-footer-inner">
                <span class="cp-auth-footer-copy">CRAFT: Campus Reservation and Asset Flow Tracker &middot; Property Office &middot; A.Y. 2026-2027</span>
            </div>
        </footer>
    </div>
    <script src="https://kit.fontawesome.com/7a7c645416.js" crossorigin="anonymous"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    @RenderSection("Scripts", required: false)
</body>
</html>