@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="cp-page-header">
    <div>
        <h1 class="cp-page-title">Something went wrong</h1>
        <p class="cp-page-subtitle">The request couldn't be completed. Try again, or go back to your dashboard.</p>
    </div>
</div>
<p><a href="/" class="cp-btn cp-btn-primary">Back to dashboard</a></p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}


