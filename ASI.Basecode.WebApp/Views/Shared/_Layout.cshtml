<div id="cp-toast-container"></div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<partial name="_ValidationScriptsPartial" />
<script>
    (function() {
        @* JSON-encode so names/reasons inside messages can't break out of the script. *@
        var success = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SuccessMessage"]?.ToString() ?? ""));
        var error = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ErrorMessage"]?.ToString() ?? ""));
        var container = document.getElementById('cp-toast-container');
        function toast(msg, cls) {
            if (!msg) return;
            var t = document.createElement('div');
            t.className = 'cp-toast ' + cls;
            t.setAttribute('role', cls === 'cp-toast-error' ? 'alert' : 'status');
            t.textContent = msg;
            container.appendChild(t);
            setTimeout(function() { t.remove(); }, 4500);
        }
        toast(success, 'cp-toast-success');
        toast(error, 'cp-toast-error');
    })();

    // Collapsible sidebar
    (function () {
        var shell = document.getElementById('craftShell');
        var toggle = document.getElementById('sidebarToggle');
        if (!shell || !toggle) return;
        document.querySelectorAll('#appSidebar .nav-item').forEach(function (item) {
            var text = item.querySelector('div');
            if (text && !item.title) item.title = text.textContent.trim();
        });
        var key = 'craft.sidebar.collapsed';
        // On narrow screens the sidebar is an overlay: closed on every page load, opened on demand.
        var narrow = window.matchMedia('(max-width: 900px)');
        function sync() {
            var open = narrow.matches ? shell.classList.contains('sidebar-open') : !shell.classList.contains('sidebar-collapsed');
            toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        }
        try {
            if (localStorage.getItem(key) === '1') shell.classList.add('sidebar-collapsed');
        } catch (e) { }
        sync();
        toggle.addEventListener('click', function () {
            if (narrow.matches) {
                shell.classList.toggle('sidebar-open');
            } else {
                var collapsed = shell.classList.toggle('sidebar-collapsed');
                try { localStorage.setItem(key, collapsed ? '1' : '0'); } catch (e) { }
            }
            sync();
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && shell.classList.contains('sidebar-open')) { shell.classList.remove('sidebar-open'); sync(); }
        });
        if (narrow.addEventListener) narrow.addEventListener('change', sync);
    })();
</script>
@RenderSection("Scripts", required: false)
