@using Microsoft.AspNetCore.Http
@using System.Security.Claims
@inject IHttpContextAccessor HttpContextAccessor
@{
    var role = User.FindFirst(ClaimTypes.Role)?.Value;
    var isAdmin = string.Equals(role, "ADMIN", StringComparison.OrdinalIgnoreCase);
    var isCustodian = string.Equals(role, "TECHNICIAN", StringComparison.OrdinalIgnoreCase);
    var isBorrower = string.Equals(role, "STUDENT", StringComparison.OrdinalIgnoreCase)
                  || string.Equals(role, "FACULTY", StringComparison.OrdinalIgnoreCase);
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var displayName = User.Identity?.Name ?? "Guest";
    var roleLabel = string.Equals(role, "STUDENT", StringComparison.OrdinalIgnoreCase) ? "Student"
                  : string.Equals(role, "FACULTY", StringComparison.OrdinalIgnoreCase) ? "Faculty"
                  : isAdmin ? "Administrator"
                  : "Custodian";
    var crumb = ViewData["Title"]?.ToString() ?? "Dashboard";
}
