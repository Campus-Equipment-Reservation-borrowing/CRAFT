@model ASI.Basecode.Services.ViewModelClasses.LandingViewModel
@{
    Layout = null;
    var decision = Model.MedianDecisionHours;
    var decisionText = decision == null ? "—" : decision < 1 ? "<1h" : decision < 48 ? $"~{Math.Round(decision.Value)}h" : $"~{Math.Round(decision.Value / 24)}d";
    ViewData["Title"] = "CRAFT: Campus Reservation and Asset Flow Tracker";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
</head>
<body>
<div class="lp-page">

    <!-- Top navigation -->
    <nav class="lp-nav">
        <div class="lp-nav-brand">
            <div class="lp-nav-logo">CR</div>
            <div>
                <div class="lp-nav-title">CRAFT</div>
                <div class="lp-nav-subtitle">Campus Reservation and Asset Flow Tracker</div>
            </div>
        </div>
        <div class="lp-nav-links">
            <a href="#overview">Overview</a>
            <a href="#availability">Equipment</a>
            <a href="#rules">Borrowing Rules</a>
        </div>
    </nav>

    <!-- Hero -->
    <section class="lp-hero" id="overview">
        <div class="lp-hero-content">
            <span class="lp-hero-badge">Property Office · A.Y. 2026–2027</span>
            <h1>Reserve campus equipment<br />without the paper queue.</h1>
            <p class="lp-hero-desc">
                CRAFT is the university's equipment operations portal. Check live availability
                of laptops, projectors, cameras, speakers and lab tools, then reserve a borrowing
                window in a few clicks. Custodians review, release and inspect every item; borrowers
                track every request from Pending to Completed.
            </p>
            <div class="lp-hero-actions">
                <a href="/Account/Login" class="lp-btn lp-btn-primary lp-btn-lg">Sign In to CRAFT</a>
                <a href="/Account/Register" class="lp-btn lp-btn-outline lp-btn-lg">Create Account</a>
            </div>
            <div class="lp-hero-stats">
                <div class="lp-stat">
                    <div class="lp-stat-value">@Model.ItemsInCatalog.ToString("N0")</div>
                    <div class="lp-stat-label">Items in catalog</div>
                </div>
                <div class="lp-stat">
                    <div class="lp-stat-value">@Model.CategoryCount</div>
                    <div class="lp-stat-label">Equipment categories</div>
                </div>
                <div class="lp-stat">
                    <div class="lp-stat-value">@decisionText</div>
                    <div class="lp-stat-label">Median decision time</div>
                </div>
            </div>
        </div>

        <!-- Live availability snapshot -->
        <div class="lp-availability-card">
            <div class="lp-availability-header">
                <span class="lp-availability-title">Live Availability Snapshot</span>
                <span class="lp-availability-updated">Updated @Model.UpdatedAtLocal.ToString("dd MMM yyyy · hh:mm tt")</span>
            </div>
            @if (!Model.Categories.Any())
            {
                <p class="lp-availability-empty">No equipment is in the catalog yet.</p>
            }
            @foreach (var c in Model.Categories.Take(5))
            {
                <div class="lp-availability-row">
                    <div>
                        <div class="lp-availability-name">@c.Name</div>
                        <div class="lp-availability-bar"><div class="lp-availability-bar-fill" style="--pct: @(c.PercentAvailable)%;"></div></div>
                    </div>
                    <div class="lp-availability-count">@c.Available / @c.Total</div>
                </div>
            }
        </div>
    </section>

    <!-- How borrowing works -->
    <section class="lp-section" id="rules">
        <h2 class="lp-section-title">How Borrowing Works</h2>
        <p class="lp-section-subtitle">Four steps from request to return.</p>
        <div class="lp-steps">
            <div class="lp-step">
                <div class="lp-step-number">1</div>
                <div class="lp-step-title">Submit a reservation</div>
                <div class="lp-step-desc">Choose equipment, schedule and purpose</div>
            </div>
            <div class="lp-step">
                <div class="lp-step-number">2</div>
                <div class="lp-step-title">Custodian review</div>
                <div class="lp-step-desc">Reviewed by a custodian, usually within one working day</div>
            </div>
            <div class="lp-step">
                <div class="lp-step-number">3</div>
                <div class="lp-step-title">Pick up equipment</div>
                <div class="lp-step-desc">Present your school ID at the Property Office</div>
            </div>
            <div class="lp-step">
                <div class="lp-step-number">4</div>
                <div class="lp-step-title">Return &amp; inspection</div>
                <div class="lp-step-desc">Condition is recorded and the record is closed</div>
            </div>
        </div>
    </section>

    <!-- What you can do -->
    <section class="lp-section">
        <h2 class="lp-section-title">What you can do</h2>
        <p class="lp-section-subtitle">One portal for borrowers, custodians and administrators.</p>
        <div class="lp-features">
            <div class="lp-feature-card">
                <div class="lp-feature-icon">&#128269;</div>
                <div class="lp-feature-title">Check availability</div>
                <div class="lp-feature-desc">Browse the catalog by category, location and condition before you request anything.</div>
            </div>
            <div class="lp-feature-card">
                <div class="lp-feature-icon">&#128197;</div>
                <div class="lp-feature-title">Reserve a schedule</div>
                <div class="lp-feature-desc">Pick your borrowing and expected return date and time, then submit with a stated purpose.</div>
            </div>
            <div class="lp-feature-card">
                <div class="lp-feature-icon">&#128203;</div>
                <div class="lp-feature-title">Track your requests</div>
                <div class="lp-feature-desc">Follow each request from Pending through Approved, Ready for Release and Completed.</div>
            </div>
            <div class="lp-feature-card">
                <div class="lp-feature-icon">&#128214;</div>
                <div class="lp-feature-title">Review your history</div>
                <div class="lp-feature-desc">Every returned item, final condition and closed transaction stays on your record.</div>
            </div>
        </div>
    </section>

    <!-- Equipment categories -->
    <section class="lp-section" id="availability">
        <h2 class="lp-section-title">Equipment categories</h2>
        <p class="lp-section-subtitle">Sign in to see live quantities and reserve.</p>
        <div class="lp-categories">
            @foreach (var c in Model.Categories)
            {
                <div class="lp-category-card">
                    <div>
                        <div class="lp-category-name">@c.Name</div>
                        <div class="lp-category-count">@c.Total units on catalog</div>
                    </div>
                    <span class="lp-category-badge">@(c.Available > 0 ? "Available" : "Fully booked")</span>
                </div>
            }
        </div>
        <div class="text-center mt-4">
            <a href="/Reservations/Available" class="lp-btn lp-btn-outline">View full catalog</a>
        </div>
    </section>

    <!-- Footer -->
    <footer class="lp-footer">
        Property Office &middot; A.Y. 2026&ndash;2027
    </footer>

</div>
</body>
</html>
