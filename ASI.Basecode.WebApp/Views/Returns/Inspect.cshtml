@using ASI.Basecode.Services.ViewModelClasses
@model InspectionFormViewModel
@{
    ViewData["Title"] = "Condition Inspection";
}
@{
    var ctx = ViewBag.Context as ReturnFormContextViewModel;
    var inspectable = ctx?.InspectableQuantity ?? 0;
    var photos = ViewBag.Photos as List<InspectionPhotoViewModel> ?? new List<InspectionPhotoViewModel>();
    var damageOptions = ViewBag.DamageOptions as List<LookupViewModel> ?? new List<LookupViewModel>();
    var outcome = string.IsNullOrEmpty(Model.Outcome) ? ConditionCodes.Good : Model.Outcome;
    var damageSelected = damageOptions.Any(d => d.Id == Model.CurrentConditionId) ? Model.CurrentConditionId : damageOptions.FirstOrDefault()?.Id ?? 0;
    var units = inspectable == 1 ? "it" : "they";
}

<div class="cp-page-header">
    <div>
        <partial name="_Breadcrumb" model='new[] { ("Returns", "/Returns") }' />
        <h1 class="cp-page-title">Condition Inspection</h1>
        <p class="cp-page-subtitle">Tell us how the equipment came back. We'll update its condition and stock for you.</p>
    </div>
</div>

<div class="cp-stack">
    <div class="cp-card cp-card-flush">
        @if (ctx != null)
        {
            <div class="cp-insp-head">
                <div class="cp-insp-icon cp-mono" aria-hidden="true">@(ctx.AssetCode?.Split('-')[0])</div>
                <div>
                    <div class="cp-cell-name">@ctx.EquipmentName</div>
                    <div class="cp-cell-sub"><span class="cp-mono">@ctx.AssetCode</span> · @ctx.TransactionNumber · @ctx.BorrowerName · @ctx.AlreadyReturned of @ctx.ReleasedQuantity returned</div>
                </div>
            </div>
        }

        <form asp-action="Inspect" method="post" enctype="multipart/form-data" class="cp-insp-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="BorrowingId" />
            <div class="cp-insp-body">
                <div asp-validation-summary="ModelOnly" class="cp-validation-summary" role="alert"></div>

                @if (inspectable == 0)
                {
                    <div class="cp-empty-state compact">
                        <div class="cp-empty-state-text">No returned units are waiting for inspection.</div>
                        <a asp-action="Create" asp-route-id="@Model.BorrowingId" class="cp-btn cp-btn-secondary cp-btn-sm">Record a return</a>
                    </div>
                }
                else
                {
                    @if (inspectable == 1)
                    {
                        <input type="hidden" name="InspectedQuantity" value="1" />
                    }
                    else
                    {
                        <div class="cp-form-group">
                            <label asp-for="InspectedQuantity" class="cp-form-label">Units in this inspection</label>
                            <input asp-for="InspectedQuantity" type="number" min="1" max="@inspectable" step="1" class="cp-input cp-insp-qty" aria-describedby="insQtyHint" />
                            <div class="cp-form-hint" id="insQtyHint">@inspectable units are waiting. If they came back differently, inspect them in batches, e.g. the good ones now and the damaged one next.</div>
                        </div>
                    }

                    <fieldset class="cp-insp-fieldset">
                        <legend class="cp-insp-q">How did @units come back?</legend>
                        <p class="cp-form-hint">This sets the condition and where the unit goes next.</p>
                        <div class="cp-outcomes">
                            <label class="cp-outcome is-good">
                                <input type="radio" name="Outcome" value="@ConditionCodes.Good" checked="@(outcome == ConditionCodes.Good)" />
                                <span class="cp-outcome-mark" aria-hidden="true">✓</span>
                                <span class="cp-outcome-title">Good</span>
                                <span class="cp-outcome-sub">Back on the shelf</span>
                            </label>
                            <label class="cp-outcome is-damaged">
                                <input type="radio" name="Outcome" value="@ConditionCodes.Damaged" checked="@(outcome == ConditionCodes.Damaged)" />
                                <span class="cp-outcome-mark" aria-hidden="true">!</span>
                                <span class="cp-outcome-title">Damaged</span>
                                <span class="cp-outcome-sub">Goes to maintenance</span>
                            </label>
                            <label class="cp-outcome is-lost">
                                <input type="radio" name="Outcome" value="@ConditionCodes.Lost" checked="@(outcome == ConditionCodes.Lost)" />
                                <span class="cp-outcome-mark" aria-hidden="true">?</span>
                                <span class="cp-outcome-title">Lost</span>
                                <span class="cp-outcome-sub">Flagged as unreconciled</span>
                            </label>
                        </div>
                    </fieldset>

                    <fieldset class="cp-insp-fieldset cp-insp-damage">
                        <legend class="cp-form-label">What's wrong?</legend>
                        <div class="cp-seg">
                            @foreach (var d in damageOptions)
                            {
                                <label><input type="radio" name="CurrentConditionId" value="@d.Id" checked="@(d.Id == damageSelected)" />@d.Text</label>
                            }
                        </div>
                    </fieldset>

                    <div class="cp-insp-costs">
                        <div class="cp-insp-grid">
                            <div class="cp-form-group">
                                <label asp-for="RepairCost" class="cp-form-label">Repair or replacement cost <span class="cp-cell-sub">(optional)</span></label>
                                <div class="cp-money"><span aria-hidden="true">₱</span><input asp-for="RepairCost" type="number" min="0" step="0.01" inputmode="decimal" class="cp-input" placeholder="1500.00" /></div>
                            </div>
                            <div class="cp-form-group">
                                <label asp-for="PenaltyAmount" class="cp-form-label">Charge the borrower <span class="cp-cell-sub">(optional)</span></label>
                                <div class="cp-money"><span aria-hidden="true">₱</span><input asp-for="PenaltyAmount" type="number" min="0" step="0.01" inputmode="decimal" class="cp-input" placeholder="500.00" /></div>
                            </div>
                        </div>
                        <div class="cp-form-group">
                            <label asp-for="PenaltyNote" class="cp-form-label">Reason for the charge <span class="cp-cell-sub">(optional, sent to the borrower)</span></label>
                            <input asp-for="PenaltyNote" maxlength="500" class="cp-input" placeholder="Cracked lens hood, replacement charged" />
                        </div>
                    </div>

                    <div class="cp-form-group">
                        <label asp-for="InspectionNotes" class="cp-form-label">Notes <span class="cp-cell-sub">(optional)</span></label>
                        <textarea asp-for="InspectionNotes" class="cp-textarea" rows="3" placeholder="Cracked grille on mic 2; cable OK"></textarea>
                    </div>

                    <div class="cp-form-group">
                        <label for="insPhotos" class="cp-form-label">Photos <span class="cp-cell-sub">(optional, up to 6, 5 MB each)</span></label>
                        <input id="insPhotos" type="file" name="photos" multiple accept="image/*" class="cp-input" />
                    </div>

                    @if (photos.Count > 0)
                    {
                        <details class="cp-insp-earlier">
                            <summary>Photos from earlier inspections (@photos.Count)</summary>
                            <div class="cp-photo-grid">
                                @foreach (var ph in photos)
                                {
                                    var url = Url.Action("Photo", "Returns", new { id = ph.InspectionId, file = ph.FileName });
                                    <a href="@url" target="_blank" rel="noopener"><img src="@url" alt="Inspection @ph.InspectionId photo @ph.FileName" loading="lazy" /></a>
                                }
                            </div>
                        </details>
                    }
                }
            </div>

            <div class="cp-insp-foot">
                <a asp-action="Index" class="cp-btn cp-btn-secondary">Cancel</a>
                @if (inspectable > 0)
                {
                    <button type="submit" name="SaveAsDraft" value="true" class="cp-btn cp-btn-secondary">Save draft</button>
                    <button type="submit" class="cp-btn cp-btn-success cp-insp-submit">Complete inspection</button>
                }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.querySelector('.cp-insp-form'), btn = form && form.querySelector('.cp-insp-submit');
            if (!btn) return;
            var labels = { '@ConditionCodes.Good': 'Return to stock', '@ConditionCodes.Damaged': 'Send to maintenance', '@ConditionCodes.Lost': 'Mark as lost' };
            function sync() {
                var picked = form.querySelector('input[name=Outcome]:checked');
                if (picked) btn.textContent = labels[picked.value];
            }
            form.addEventListener('change', sync);
            sync();
        })();
    </script>
}
