@using ASI.Basecode.Services.ViewModelClasses
@model ReturnsIndexViewModel
@{
    ViewData["Title"] = "Return Processing";
}

<div class="cp-page-header">
    <div>
        <h1 class="cp-page-title">Return Processing</h1>
        <p class="cp-page-subtitle">Pick a borrowed item below to record its return, then inspect its condition.</p>
    </div>
</div>

<div class="cp-filter-bar">
    <form method="get" asp-action="Index" class="cp-contents">
        <input type="text" name="search" aria-label="Search" maxlength="100" value="@Model.Search" class="cp-input" placeholder="Search by borrower, equipment or transaction..." />
        <button type="submit" class="cp-btn cp-btn-secondary cp-btn-sm">Apply</button>
        <a asp-action="Index" class="cp-btn cp-btn-secondary cp-btn-sm">Clear</a>
    </form>
</div>

@{
    var borrowed = ViewBag.Borrowed as ActiveBorrowingsIndexViewModel;
    var borrowedItems = borrowed?.Page?.Items ?? new List<ActiveBorrowingRowViewModel>();
}
<div class="cp-card cp-card-flush">
    <div class="cp-card-header">
        Borrowed items awaiting return
        @if (borrowed?.Page != null && borrowed.Page.TotalCount > borrowedItems.Count)
        {
            <span class="cp-cell-sub">Showing @borrowedItems.Count of @borrowed.Page.TotalCount. Search to narrow down.</span>
        }
    </div>
    @if (!borrowedItems.Any())
    {
        <div class="cp-empty-state compact">
            <div class="cp-empty-state-text">No borrowed items awaiting return.</div>
        </div>
    }
    else
    {
        <div class="cp-table-wrap">
            <table class="cp-table">
                <thead>
                    <tr>
                        <th>Transaction #</th>
                        <th>Borrower</th>
                        <th>Equipment</th>
                        <th class="text-center">Qty</th>
                        <th>Due</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in borrowedItems)
                    {
                        <tr>
                            <td class="cp-mono">@b.TransactionNumber</td>
                            <td>@b.BorrowerName</td>
                            <td>
                                <div class="cp-cell-name">@b.EquipmentName</div>
                                <div class="cp-cell-sub cp-mono">@b.AssetCode</div>
                            </td>
                            <td class="text-center cp-mono">@b.ReleasedQuantity</td>
                            <td>@b.DueAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td>
                                @if (b.IsOverdue)
                                {
                                    <span class="@StatusBadge.Css("OVERDUE")">Overdue @b.DaysOverdue d</span>
                                }
                                else
                                {
                                    <span class="@StatusBadge.Css(b.StatusCode)">@b.StatusDescription</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Create" asp-route-id="@b.BorrowingId" class="cp-btn cp-btn-primary cp-btn-sm">Record return</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<h2 class="cp-section-title">Return history</h2>

@if (!Model.Page.Items.Any())
{
    <div class="cp-empty-state compact">
        <div class="cp-empty-state-text">No returns recorded yet.</div>
    </div>
}
else
{
    <div class="cp-table-wrap">
        <table class="cp-table">
            <thead>
                <tr>
                    <th>Transaction #</th>
                    <th>Borrower</th>
                    <th>Equipment</th>
                    <th class="text-center">Returned</th>
                    <th>Returned At</th>
                    <th>Timeliness</th>
                    <th>Received By</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Page.Items)
                {
                    <tr>
                        <td class="cp-mono">@r.TransactionNumber</td>
                        <td>@r.BorrowerName</td>
                        <td>
                            <div class="cp-cell-name">@r.EquipmentName</div>
                            <div class="cp-cell-sub cp-mono">@r.AssetCode</div>
                        </td>
                        <td class="text-center cp-mono">@r.ReturnedQuantity</td>
                        <td>@r.ReturnedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td>
                            @if (r.WasReturnedLate)
                            {
                                <span class="@StatusBadge.Css(BorrowingStatusCodes.Overdue)">Late @r.DaysOverdue d</span>
                            }
                            else
                            {
                                <span class="@StatusBadge.Css(BorrowingStatusCodes.Returned)">On time</span>
                            }
                        </td>
                        <td>@(r.ReceivedBy ?? "—")</td>
                        <td class="text-center">
                            @if (r.NeedsInspection)
                            {
                                <a asp-action="Inspect" asp-route-id="@r.BorrowingId" class="cp-btn cp-btn-primary cp-btn-sm">Inspect</a>
                            }
                            else
                            {
                                <span class="cp-cell-sub">Inspected</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.Page != null && Model.Page.TotalPages > 1)
{
    <div class="cp-pagination">
        <span class="cp-pagination-info">Page @Model.Page.Page of @Model.Page.TotalPages (@Model.Page.TotalCount records)</span>
        <ul class="cp-pagination-list">
            <li class="@(Model.Page.HasPrevious ? "" : "disabled")">
                <a asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page.Page - 1)">‹</a>
            </li>
            @for (var p = 1; p <= Model.Page.TotalPages; p++)
            {
                <li class="@(p == Model.Page.Page ? "active" : "")">
                    <a asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@p">@p</a>
                </li>
            }
            <li class="@(Model.Page.HasNext ? "" : "disabled")">
                <a asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page.Page + 1)">›</a>
            </li>
        </ul>
    </div>
}