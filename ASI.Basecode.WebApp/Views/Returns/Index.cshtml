@using ASI.Basecode.Services.ViewModelClasses
@model ReturnsIndexViewModel
@{
    ViewData["Title"] = "Return Processing";
}

<div class="cp-page-header">
    <div>
        <h1 class="cp-page-title">Return Processing</h1>
        <p class="cp-page-subtitle">Record equipment returns and condition inspections.</p>
    </div>
</div>

<div class="cp-filter-bar">
    <form method="get" asp-action="Index" class="cp-contents">
        <input type="text" name="search" aria-label="Search" maxlength="100" value="@Model.Search" class="cp-input" placeholder="Search by borrower, equipment or transaction..." />
        <button type="submit" class="cp-btn cp-btn-secondary cp-btn-sm">Apply</button>
        <a asp-action="Index" class="cp-btn cp-btn-secondary cp-btn-sm">Clear</a>
    </form>
</div>

@if (!Model.Page.Items.Any())
{
    <div class="cp-empty-state compact">
        <div class="cp-empty-state-text">No returns recorded yet.</div>
    </div>
}
else
{
    <div class="cp-table-wrap">
        <table class="cp-table">
            <thead>
                <tr>
                    <th>Transaction #</th>
                    <th>Borrower</th>
                    <th>Equipment</th>
                    <th class="text-center">Returned</th>
                    <th>Returned At</th>
                    <th>Timeliness</th>
                    <th>Received By</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Page.Items)
                {
                    <tr>
                        <td class="cp-mono">@r.TransactionNumber</td>
                        <td>@r.BorrowerName</td>
                        <td>
                            <div class="cp-cell-name">@r.EquipmentName</div>
                            <div class="cp-cell-sub cp-mono">@r.AssetCode</div>
                        </td>
                        <td class="text-center cp-mono">@r.ReturnedQuantity</td>
                        <td>@r.ReturnedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td>
                            @if (r.WasReturnedLate)
                            {
                                <span class="@StatusBadge.Css("OVERDUE")">Late @r.DaysOverdue d</span>
                            }
                            else
                            {
                                <span class="@StatusBadge.Css("RETURNED")">On time</span>
                            }
                        </td>
                        <td>@(r.ReceivedBy ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.Page != null && Model.Page.TotalPages > 1)
{
    <div class="cp-pagination">
        <span class="cp-pagination-info">Page @Model.Page.Page of @Model.Page.TotalPages (@Model.Page.TotalCount records)</span>
        <ul class="cp-pagination-list">
            <li class="@(Model.Page.HasPrevious ? "" : "disabled")">
                <a asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page.Page - 1)">‹</a>
            </li>
            @for (var p = 1; p <= Model.Page.TotalPages; p++)
            {
                <li class="@(p == Model.Page.Page ? "active" : "")">
                    <a asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@p">@p</a>
                </li>
            }
            <li class="@(Model.Page.HasNext ? "" : "disabled")">
                <a asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page.Page + 1)">›</a>
            </li>
        </ul>
    </div>
}